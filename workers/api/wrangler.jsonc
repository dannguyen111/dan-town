{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "dan-town",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	// Custom domains: Cloudflare creates the DNS records and certificates on deploy.
	"routes": [
		{ "pattern": "si-dan.com", "custom_domain": true },
		{ "pattern": "www.si-dan.com", "custom_domain": true }
	],
	// The static Astro build is served directly; the Worker only runs for /api/*.
	"assets": {
		"directory": "../../apps/web/dist",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		],
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash"
	},
	// Cached GitHub / LeetCode / Spotify stats.
	"kv_namespaces": [
		{
			"binding": "STATS",
			"id": "3c756aaf1d8348418d358a9118e1f30f"
		}
	],
	// Refresh live stats once a day (06:17 UTC). The browser never calls those services.
	"triggers": {
		"crons": [
			"17 6 * * *"
		]
	},
	// Per-visitor limits: twin messages, spoken sentences, arcade results reported, and fridge notes.
	"ratelimits": [
		{
			"name": "TWIN_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 8,
				"period": 60
			}
		},
		{
			"name": "MANCALA_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 6,
				"period": 60
			}
		},
		{
			"name": "FRIDGE_LIMITER",
			"namespace_id": "1003",
			"simple": {
				"limit": 3,
				"period": 60
			}
		},
		{
			// One call per spoken sentence, so looser than TWIN_LIMITER.
			"name": "SPEAK_LIMITER",
			"namespace_id": "1004",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	],
	// SQLite-backed Durable Objects, created on deploy: the arcade robot's win/loss record, the
	// notes visitors pin on the fridge at Home, and meeting requests from the twin chat.
	"durable_objects": {
		"bindings": [
			{
				"name": "MANCALA",
				"class_name": "MancalaRecordStore"
			},
			{
				"name": "FRIDGE",
				"class_name": "FridgeStore"
			},
			{
				"name": "BOOKING",
				"class_name": "BookingStore"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["MancalaRecordStore"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["FridgeStore"]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": ["BookingStore"]
		}
	],
	// Emails Dan when someone leaves a note (from fridge@) or asks for a meeting (from twin@), at the
	// FRIDGE_NOTIFY_TO secret. Email Sending must be enabled for the domain. When Dan declines a
	// meeting, the visitor gets a short note from twin@ too.
	"send_email": [
		{ "name": "FRIDGE_MAIL" }
	],
	"vars": {
		// OpenRouter model ID. Leave TWIN_MODEL empty to keep the twin "offline". Every OpenRouter call
		// is Zero Data Retention only, so each model here needs a ZDR endpoint.
		"TWIN_MODEL": "openai/gpt-6-luna",
		// The twin's voice: an OpenRouter speech model and voice. Leave TTS_MODEL empty to turn it off.
		"TTS_MODEL": "hexgrad/kokoro-82m",
		"TTS_VOICE": "am_michael",
		// Jev model that sorts fridge notes (hiring / collab / hi) and flags injection, called through
		// OpenRouter's Decisions API with OPENROUTER_API_KEY.
		"FRIDGE_MODEL": "typesafe/jev-1.13",
		"SITE_URL": "https://si-dan.com",
		// Calendar the twin checks free/busy on and adds approved meetings to.
		"GOOGLE_CALENDAR_ID": "primary"
	},
	// Secrets (set with `wrangler secret put`): OPENROUTER_API_KEY, GITHUB_TOKEN,
	// SPOTIFY_CLIENT_ID, SPOTIFY_CLIENT_SECRET, SPOTIFY_REFRESH_TOKEN, TURNSTILE_SECRET (optional),
	// FRIDGE_SECRET, FRIDGE_NOTIFY_TO, and for meeting requests (scripts/google-auth.mjs):
	// GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REFRESH_TOKEN, BOOKING_SECRET
	"observability": {
		"enabled": true
	}
}