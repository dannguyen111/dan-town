---
import { EXTERNAL_LINKS, PLACES } from "../lib/locations";

const places = Object.fromEntries(PLACES.map((p) => [p.id, { name: p.name, href: p.href }]));
const links = Object.fromEntries(EXTERNAL_LINKS.map((l) => [l.id, { label: l.label, url: l.url }]));
---

<section class="town" aria-labelledby="town-title" transition:persist="town" data-town data-places={JSON.stringify(places)} data-links={JSON.stringify(links)}>
  <h2 id="town-title" class="visually-hidden">Town map</h2>
  <p id="town-help" class="visually-hidden">
    An interactive pixel-art town. Use the arrow keys or W A S D to walk, Enter to interact, or click or tap where you want to go.
    Every place is also listed in the Map menu and under "Where to?".
  </p>
  <canvas tabindex="0" role="img" aria-label="Pixel-art town. Walk into buildings to explore." aria-describedby="town-help"></canvas>
  <div class="town-labels" data-town-labels></div>
  <button class="town-pov-exit" type="button" data-pov-exit>← Back to the room</button>
  <div class="town-bubble" data-town-bubble role="status" hidden></div>
  <div class="visually-hidden" aria-live="polite" data-town-live></div>
  <noscript><p class="town-noscript">The town needs JavaScript, but every page works without it. Use the menu above.</p></noscript>
</section>

<script>
  import { navigate } from "astro:transitions/client";
  import { Town } from "../town/town";

  const root = document.querySelector<HTMLElement>("[data-town]")!;
  let enteredFromTown = false;

  const town = new Town(root, {
    places: JSON.parse(root.dataset.places!),
    links: JSON.parse(root.dataset.links!),
    onEnterPlace: (_id, href) => {
      if (location.pathname === href) return;
      enteredFromTown = true;
      navigate(href);
    },
    // e.g. talking to the arcade robot fires "town:mancala".
    onEvent: (name) => document.dispatchEvent(new CustomEvent(`town:${name}`)),
  });

  const sync = () => {
    const place = document.documentElement.dataset.place ?? "town";
    if (town.hasInterior(place)) {
      // Places with an interior: the visitor walks inside the room.
      town.enterScene(place);
      town.setPov(null);
    } else if (town.hasPlaceHere(place)) {
      // A place reachable from inside the room (the twin on the Home couch) opens beside it,
      // and the room cuts to the twin facing you while you talk.
      town.setActivePlace(place);
      if (!enteredFromTown) town.teleportToPlace(place);
      town.setPov(place === "twin" ? "couch" : null);
    } else {
      const inside = town.sceneId;
      // Leaving a building puts the visitor back outside its door, facing the street.
      if (town.enterScene("town")) town.teleportToPlace(inside, "down");
      town.setActivePlace(place);
      // Arrivals from the Map menu, links, or a fresh deep link: put the visitor at that door.
      if (!enteredFromTown && place !== "town") town.teleportToPlace(place);
    }
    enteredFromTown = false;
  };
  document.addEventListener("astro:page-load", sync);

  // On small screens the town square shows a "peek" card over the bottom of the map.
  const updateInset = () => {
    const panel = document.querySelector<HTMLElement>(".panel");
    if (!panel) return;
    const r = root.getBoundingClientRect();
    const p = panel.getBoundingClientRect();
    const overlaps = p.top > r.top && p.top < r.bottom && p.left < r.right && p.right > r.left;
    town.setBottomInset(overlaps ? r.bottom - p.top : 0);
  };
  document.addEventListener("astro:page-load", () => requestAnimationFrame(updateInset));
  addEventListener("resize", updateInset);

  // Leaving the close-up of the twin: back to the room's own page, where walking works again.
  const places = JSON.parse(root.dataset.places!) as Record<string, { href: string }>;
  root.querySelector("[data-pov-exit]")!.addEventListener("click", () => {
    const room = places[town.sceneId];
    if (room) navigate(room.href);
  });
  // Close-ups (the TV, the desk) zoom in from the object on screen. Replies synchronously.
  document.addEventListener("town:rect", (e) => {
    const { id, reply } = (e as CustomEvent<{ id: string; reply: (r: DOMRect | null) => void }>).detail;
    reply(town.objectScreenRect(id));
  });
  // The Map menu and other links can ask the town to walk somewhere.
  document.addEventListener("town:focus", () => town.focus());
  // Pages can show a message in the town's text box, e.g. the arcade scoreboard.
  document.addEventListener("town:note", (e) => {
    const { title, text } = (e as CustomEvent<{ title: string; text: string }>).detail;
    town.showNote(title, text);
  });
  // Full-screen experiences (the arcade game) pause walking while they're open.
  document.addEventListener("town:pause", () => town.setEnabled(false));
  document.addEventListener("town:resume", () => town.setEnabled(true));
</script>

<style>
  .town {
    position: relative;
    overflow: hidden;
    background: #4f9d4a;
    touch-action: manipulation;
    user-select: none;
    -webkit-user-select: none;
  }
  canvas {
    display: block;
    image-rendering: pixelated;
    cursor: pointer;
  }
  canvas:focus-visible {
    outline: 4px solid var(--sun);
    outline-offset: -4px;
    border-radius: 0;
  }
  .town-labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  /* A close-up (the twin facing you) replaces the room: its name tags would float over nothing. */
  .town[data-pov] .town-labels {
    display: none;
  }
  .town[data-pov] canvas {
    cursor: default;
  }
  .town-pov-exit {
    display: none;
    position: absolute;
    left: 12px;
    top: 12px;
    min-height: 36px;
    padding: 6px 10px;
    font: 10px/1 var(--font-retro, monospace);
    color: #181820;
    background: #f8f8f0;
    border: 0;
    box-shadow:
      0 -3px 0 0 #181820,
      0 3px 0 0 #181820,
      -3px 0 0 0 #181820,
      3px 0 0 0 #181820;
    cursor: pointer;
  }
  .town[data-pov] .town-pov-exit {
    display: block;
  }
  .town-pov-exit:hover,
  .town-pov-exit:focus-visible {
    background: var(--sun);
  }
  .town-labels :global(.town-label) {
    position: absolute;
    left: 0;
    top: 0;
    pointer-events: auto;
    font-family: var(--font-pixel);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    color: var(--ink);
    background: rgba(255, 252, 245, 0.94);
    border: 2px solid var(--ink);
    border-radius: 8px;
    padding: 5px 8px;
    min-height: 26px;
    cursor: pointer;
    box-shadow: 0 2px 0 var(--ink);
  }
  .town-labels :global(.town-label:hover),
  .town-labels :global(.town-label[aria-current]) {
    background: var(--sun);
  }
  .town-labels :global(.town-label--npc) {
    background: var(--teal);
    color: #fff;
  }
  .town-labels :global(.town-label--board),
  .town-labels :global(.town-label--signpost),
  .town-labels :global(.town-label--mailbox),
  .town-labels :global(.town-label--statue),
  .town-labels :global(.town-label--stall) {
    font-size: 0.7rem;
    padding: 4px 6px;
    min-height: 22px;
  }
  .town-bubble {
    position: absolute;
    left: 50%;
    bottom: 16px;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    max-width: calc(100% - 32px);
    padding: 0.7rem 2.6rem 0.7rem 1rem;
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: 14px;
    box-shadow: 0 4px 0 var(--ink);
  }
  .town-bubble[hidden] {
    display: none;
  }
  .town-bubble :global(a) {
    font-weight: 800;
  }
  /* The action of something you face (the TV, the fridge): looks like the bubble's links. */
  .town-bubble :global(.town-bubble__action) {
    padding: 0;
    font: inherit;
    font-weight: 800;
    color: var(--coral-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .town-bubble :global(.town-bubble__hint) {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    transform: translateX(-50%);
    white-space: nowrap;
    padding: 0.25rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--paper);
    background: var(--ink);
    border-radius: 999px;
    pointer-events: none;
    animation: town-hint-pop 0.25s ease-out both;
  }
  .town-bubble :global(.town-bubble__hint kbd) {
    display: inline-block;
    margin: 0 0.15rem;
    padding: 0 0.35rem;
    font: inherit;
    color: var(--ink);
    background: var(--paper);
    border-radius: 4px;
  }
  @keyframes town-hint-pop {
    from {
      opacity: 0;
      transform: translate(-50%, 4px) scale(0.9);
    }
  }
  @media (hover: none) and (pointer: coarse) {
    .town-bubble :global(.town-bubble__hint) {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .town-bubble :global(.town-bubble__hint) {
      animation: none;
    }
  }
  .town-bubble :global(.town-bubble__close) {
    position: absolute;
    right: 6px;
    top: 50%;
    transform: translateY(-50%);
    width: 32px;
    height: 32px;
    border: 0;
    background: none;
    font-size: 1.4rem;
    cursor: pointer;
    color: var(--ink);
  }
  /* ─────────────── retro scenes (the arcade): soft gray RPG text boxes and tags ─────────────── */
  .town[data-retro] .town-bubble {
    display: block;
    width: min(640px, calc(100% - 40px));
    padding: 1.1em 3.2em 1.1em 1.5em;
    font: 12px/2 var(--font-retro, monospace);
    color: #2b2b33;
    background: linear-gradient(#f1f1f4, #e2e2e8);
    border: 3px solid #4a4a56;
    border-radius: 12px;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.6) inset,
      0 10px 24px rgba(10, 6, 20, 0.35);
    animation: town-retro-in 0.25s ease-out;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  /* Keep [hidden] working: the display: block above would otherwise override it. */
  .town[data-retro] .town-bubble[hidden] {
    display: none;
  }
  /* A soft inner frame, the way old RPG text boxes had a double border. */
  .town[data-retro] .town-bubble::before {
    content: "";
    position: absolute;
    inset: 4px;
    border: 2px solid #b4b4c0;
    border-radius: 8px;
    pointer-events: none;
  }
  .town[data-retro] .town-bubble:global(.is-leaving) {
    opacity: 0;
    transform: translate(-50%, 8px);
  }
  .town[data-retro] .town-bubble :global(span) {
    white-space: pre-wrap;
  }
  .town[data-retro] .town-bubble :global(strong) {
    display: block;
    margin-bottom: 0.4em;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #5a5a6e;
  }
  .town[data-retro] .town-bubble :global(.town-bubble__close) {
    right: 10px;
    top: 10px;
    transform: none;
    font: 14px var(--font-retro, monospace);
    color: #4a4a56;
  }
  .town[data-retro] .town-labels :global(.town-label) {
    font: 9px/1 var(--font-retro, monospace);
    padding: 6px 8px;
    border: 0;
    border-radius: 0;
    color: #181820;
    background: #f8f8f0;
    box-shadow:
      0 -3px 0 0 #181820,
      0 3px 0 0 #181820,
      -3px 0 0 0 #181820,
      3px 0 0 0 #181820;
  }
  .town[data-retro] .town-labels :global(.town-label--npc) {
    color: #f8d030;
    background: #181820;
    box-shadow:
      0 -3px 0 0 #f8d030,
      0 3px 0 0 #f8d030,
      -3px 0 0 0 #f8d030,
      3px 0 0 0 #f8d030;
  }
  @keyframes town-retro-in {
    from {
      transform: translate(-50%, 10px);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .town[data-retro] .town-bubble {
      animation: none;
      transition: none;
    }
  }

  .town-noscript {
    position: absolute;
    inset: auto 16px 16px;
    background: var(--paper);
    padding: 1rem;
    border-radius: 12px;
  }
</style>
