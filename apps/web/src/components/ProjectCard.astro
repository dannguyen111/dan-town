---
/**
 * A project as a mission-control launch card: codename and status in the header bar, then the
 * title, dates, tagline, stack and links. No photo. Lives inside a .mcp terminal panel (global.css).
 */
import type { Project } from "@dan-town/profile/schema";
import { codename, projectLinks, projectStatus, projectWhen } from "../lib/profile";
import StackChip from "./StackChip.astro";

interface Props {
  project: Project;
}
const { project } = Astro.props;
const status = projectStatus(project);
---

<article class="launch">
  <header class="launch__bar">
    <span class="launch__code">{codename(project.title, project.id)}</span>
    <span class={`launch__status launch__status--${status.toLowerCase()}`}>{status}</span>
  </header>
  <div class="launch__body">
    <h3 class="launch__title">
      <a href={`/projects/${project.id}`}>{project.title}</a>
    </h3>
    <p class="launch__when">{projectWhen(project)}</p>
    <p class="launch__tagline">{project.tagline}</p>
    <ul class="stack-chips" aria-label="Technologies">
      {project.tags.map((t) => <StackChip name={t} />)}
    </ul>
    <p class="launch__links">
      <a href={`/projects/${project.id}`}>Debrief →</a>
      {
        projectLinks(project).map((l) => (
          <a href={l.href} {...(l.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
            {l.label}
          </a>
        ))
      }
    </p>
  </div>
</article>

<style>
  .launch {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--mcp-card);
    border: 2px solid var(--mcp-line);
    box-shadow: 4px 4px 0 #070a14;
    transition: border-color 0.15s;
  }
  .launch:hover,
  .launch:focus-within {
    border-color: var(--mcp-cyan);
  }
  .launch p,
  .launch h3 {
    margin: 0;
  }
  .launch__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.7rem;
    background: #080d1b;
    border-bottom: 2px solid var(--mcp-line);
  }
  .launch__code {
    font: 400 0.5rem/1.4 var(--font-retro, monospace);
    color: var(--mcp-cyan);
  }
  .launch__status {
    font: 400 0.45rem/1.4 var(--font-retro, monospace);
    color: var(--mcp-dim);
    white-space: nowrap;
  }
  .launch__status--active {
    color: var(--mcp-green);
  }
  .launch__status--active::before {
    content: "● ";
    animation: mcp-blink 1.4s steps(1) infinite;
  }
  .launch__body {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    flex: 1;
    padding: 0.8rem;
  }
  .launch__title {
    font: 400 0.62rem/1.6 var(--font-retro, monospace);
  }
  .launch__title a {
    color: #fff;
    text-decoration: none;
  }
  .launch__title a:hover {
    color: var(--mcp-amber);
  }
  .launch__when {
    color: var(--mcp-dim);
    font-size: 1.1rem;
  }
  .launch__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    margin-top: auto !important;
    padding-top: 0.3rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .launch__status--active::before {
      animation: none;
    }
  }
</style>
