---
import { profile } from "../lib/profile";
const login = profile.integrations.github.username;
---

<section class="gh-term" data-github aria-labelledby="gh-title" aria-busy="true">
  <div class="gh-term__head">
    <h3 id="gh-title" class="brief__label">GitHub · last 3 months</h3>
    <span class="gh-term__updated" data-updated></span>
  </div>
  <div data-body>
    <p class="gh-term__dim">Loading activity…</p>
  </div>
  <noscript><p>See <a href={`https://github.com/${login}`}>github.com/{login}</a>.</p></noscript>
  <template data-fallback>
    <p class="gh-term__dim">
      Live GitHub stats aren't available right now.
      {login && <>Visit <a href={`https://github.com/${login}`} target="_blank" rel="noopener noreferrer">github.com/{login}</a> instead.</>}
    </p>
  </template>
</section>

<script>
  import { fmtUpdated, h, loadStats } from "../lib/stats-client";

  /** Days of activity shown: the last 13 weeks. */
  const DAYS = 13 * 7;

  async function render() {
    const root = document.querySelector<HTMLElement>("[data-github]");
    if (!root || root.dataset.rendered) return;
    root.dataset.rendered = "1";
    const body = root.querySelector<HTMLElement>("[data-body]")!;
    const stats = await loadStats();
    root.removeAttribute("aria-busy");
    const gh = stats?.github;
    if (!gh) {
      body.replaceChildren(root.querySelector<HTMLTemplateElement>("[data-fallback]")!.content.cloneNode(true));
      return;
    }
    root.querySelector("[data-updated]")!.textContent = fmtUpdated(stats!.updatedAt);

    // Contribution heatmap as an LED panel: 7 rows, one column per week.
    const days = gh.calendar.slice(-DAYS);
    const total = days.reduce((n, d) => n + d.count, 0);
    const graph = h("div", { class: "gh-graph", role: "img", "aria-label": `${total} contributions in the last 3 months` });
    const firstDay = new Date(days[0]?.date ?? Date.now()).getUTCDay();
    for (let i = 0; i < firstDay; i++) graph.append(h("span", { class: "gh-cell gh-cell--pad" }));
    for (const d of days) graph.append(h("span", { class: `gh-cell l${d.level}`, title: `${d.count} on ${d.date}` }));

    const repos = h(
      "ul",
      { class: "gh-repos" },
      ...gh.repos.map((r) =>
        h(
          "li",
          {},
          h("a", { href: r.url, target: "_blank", rel: "noopener noreferrer" }, r.name),
          r.description ? h("span", { class: "gh-term__dim" }, ` · ${r.description}`) : null,
          h("span", { class: "gh-meta" }, [r.language, r.stars ? `★ ${r.stars}` : ""].filter(Boolean).join(" · ")),
        ),
      ),
    );

    body.replaceChildren(
      h("div", { class: "gh-graph-wrap" }, graph),
      h("h4", { class: "brief__label" }, "Recently active"),
      repos,
    );
  }
  document.addEventListener("astro:page-load", render);
</script>

<style is:global>
  .gh-term {
    margin-top: 1rem;
    color: var(--mc-text);
  }
  .gh-term__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .gh-term__updated,
  .gh-term__dim,
  .gh-meta {
    color: var(--mc-dim);
  }
  .gh-term__updated {
    font-size: 1rem;
  }
  .gh-term a {
    color: var(--mc-cyan);
  }
  .gh-graph-wrap {
    padding: 0.6rem;
    background: var(--mc-panel);
    border: 2px solid var(--mc-line);
  }
  .gh-graph {
    display: grid;
    grid-template-rows: repeat(7, auto);
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 3px;
  }
  .gh-cell {
    aspect-ratio: 1;
    background: #1a2444;
  }
  .gh-cell--pad {
    background: transparent;
  }
  .gh-cell.l1 { background: #1f6b4a; }
  .gh-cell.l2 { background: #2fae6e; }
  .gh-cell.l3 { background: #4fe08f; box-shadow: 0 0 4px rgba(125, 255, 176, 0.4); }
  .gh-cell.l4 { background: var(--mc-green); box-shadow: 0 0 6px rgba(125, 255, 176, 0.7); }
  .gh-repos {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.4rem;
  }
  .gh-meta {
    display: block;
    font-size: 1rem;
  }
</style>
