---
import { Image } from "astro:assets";
import { marked } from "marked";
import TownLayout from "../../layouts/TownLayout.astro";
import StackChip from "../../components/StackChip.astro";
import { profile, codename, projectLinks, projectStatus, projectWhen } from "../../lib/profile";
import { resolveImage } from "../../lib/images";

export function getStaticPaths() {
  return profile.projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const img = resolveImage(project.image);
// The profile is trusted, author-controlled content; render its Markdown at build time.
const html = await marked.parse(project.body);
const status = projectStatus(project);
const links = projectLinks(project);
---

<TownLayout place="dev" title={project.title} description={project.tagline}>
  <div class="mcp">
    <a href="/dev" class="mcp-btn debrief-back">← Mission control</a>

    <article class="debrief" aria-labelledby="panel-title">
      <header class="debrief__bar">
        <span class="debrief__code">{codename(project.title, project.id)}</span>
        <span class={`debrief__status debrief__status--${status.toLowerCase()}`}>{status}</span>
      </header>
      <div class="debrief__head">
        <p class="mcp-kicker">Mission debrief · {projectWhen(project)}</p>
        <h1 id="panel-title" class="debrief__title" tabindex="-1">{project.title}</h1>
        <p class="debrief__tagline">{project.tagline}</p>
        {
          links.length > 0 && (
            <p class="debrief__links">
              {links.map((l, i) => (
                <a class={`mcp-btn ${i === 0 ? "mcp-btn--primary" : ""}`} href={l.href} {...(l.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
                  {l.label}
                </a>
              ))}
            </p>
          )
        }
      </div>
    </article>

    {
      img && (
        <figure class="debrief__shot">
          <Image src={img} alt="" width={960} height={540} />
        </figure>
      )
    }

    <section aria-labelledby="payload-title">
      <h2 id="payload-title" class="mcp-h">Payload</h2>
      <ul class="stack-chips" aria-label="Technologies">
        {project.tags.map((t) => <StackChip name={t} />)}
      </ul>
    </section>

    <section aria-labelledby="log-title">
      <h2 id="log-title" class="mcp-h">Mission log</h2>
      <div class="debrief__log" set:html={html} />
    </section>

    <a href="/dev" class="mcp-btn debrief-back">← Back to all launches</a>
  </div>
</TownLayout>

<style>
  .debrief-back {
    justify-self: start;
  }
  .debrief {
    background: var(--mcp-card);
    border: 2px solid var(--mcp-line);
    box-shadow: 4px 4px 0 #070a14;
  }
  .debrief__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.9rem;
    background: #080d1b;
    border-bottom: 2px solid var(--mcp-line);
  }
  .debrief__code {
    font: 400 0.6rem/1.4 var(--font-retro, monospace);
    color: var(--mcp-cyan);
  }
  .debrief__status {
    font: 400 0.5rem/1.4 var(--font-retro, monospace);
    color: var(--mcp-dim);
  }
  .debrief__status--active {
    color: var(--mcp-green);
  }
  .debrief__status--active::before {
    content: "● ";
    animation: mcp-blink 1.4s steps(1) infinite;
  }
  .debrief__head {
    display: grid;
    gap: 0.7rem;
    padding: 1rem;
  }
  .debrief__title {
    font: 400 clamp(0.95rem, 2vw, 1.25rem) / 1.5 var(--font-retro, monospace);
    color: #fff;
    text-shadow: 3px 3px 0 #1d6f86;
  }
  .debrief__title:focus {
    outline: none;
  }
  .debrief__tagline {
    color: var(--mcp-green);
  }
  .debrief__tagline::before {
    content: "> ";
  }
  .debrief__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  /* The screenshot, on a monitor: a cyan bezel and scanlines over the image. */
  .debrief__shot {
    position: relative;
    margin: 0;
    border: 3px solid var(--mcp-line);
    box-shadow:
      4px 4px 0 #070a14,
      0 0 0 1px var(--mcp-cyan);
  }
  .debrief__shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .debrief__shot::after {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.12) 0 1px, transparent 1px 3px);
    pointer-events: none;
  }
  /* The project's write-up, as a terminal log. */
  .debrief__log {
    display: grid;
    gap: 0.8rem;
  }
  .debrief__log :global(h3),
  .debrief__log :global(h4) {
    margin: 0.6rem 0 0;
    font: 400 0.55rem/1.6 var(--font-retro, monospace);
    color: var(--mcp-amber);
    text-transform: uppercase;
  }
  .debrief__log :global(p) {
    margin: 0;
  }
  .debrief__log :global(strong) {
    color: #fff;
    font-weight: 400;
  }
  .debrief__log :global(ul),
  .debrief__log :global(ol) {
    margin: 0;
    padding-left: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  .debrief__log :global(ul > li) {
    position: relative;
    padding-left: 1.2rem;
  }
  .debrief__log :global(ul > li)::before {
    content: "▸";
    position: absolute;
    left: 0;
    color: var(--mcp-cyan);
  }
  .debrief__log :global(ol) {
    list-style: decimal inside;
  }
  @media (prefers-reduced-motion: reduce) {
    .debrief__status--active::before {
      animation: none;
    }
  }
</style>
