---
import TownLayout from "../layouts/TownLayout.astro";
import PixelPortrait from "../components/PixelPortrait.astro";
import StackChip from "../components/StackChip.astro";
import { PLACES } from "../lib/locations";
import { profile } from "../lib/profile";

const destinations = PLACES.filter((p) => p.id !== "town");
const edu = profile.education[0];
const current = profile.experience.find((e) => e.end === null);
// "B.S. in Computer Science and Mathematics" → "B.S. CS + Math"
const degree = edu?.degree.replace(" in ", " ").replace("Computer Science", "CS").replace(" and ", " + ").replace("Mathematics", "Math");
const credits = [degree, edu?.rank && `Rank ${edu.rank}`, edu?.end && `Class of ${edu.end.slice(0, 4)}`].filter(Boolean);
// The three builds pinned on the board, in this order.
const PINNED = ["vendora", "appc-chatbot", "st-petersburg"];
// "Vendora: Vendor-First Marketplace Platform" → "Vendora"
const builds = PINNED.flatMap((id) => profile.projects.filter((p) => p.id === id)).map((p) => ({ ...p, short: p.title.split(":")[0]! }));
const LOADOUT = ["Python", "TypeScript", "Go", "LangGraph", "LlamaIndex", "AWS Bedrock", "PostgreSQL", "Docker"];
const allSkills = new Set(profile.skills.flatMap((g) => g.items));
const toolbelt = LOADOUT.filter((s) => allSkills.has(s));
---

<TownLayout place="town">
  <section class="board" aria-labelledby="panel-title">
    <p class="board__plank" aria-hidden="true">Town Hall · Notice board</p>

    <div class="cork">
      <article class="note note--mayor">
        <PixelPortrait class="mayor__avatar" bg="#7cc8f2" animate />
        <div class="mayor__text">
          <h1 id="panel-title" class="mayor__name" tabindex="-1">{profile.identity.name}</h1>
          <p class="mayor__role">{profile.identity.headline}</p>
        </div>
        <p class="mayor__tagline">{profile.identity.tagline}</p>
        {credits.length > 0 && <p class="mayor__credits">{credits.join(" · ")}</p>}
      </article>

      {
        current && (
          <article class="note note--now">
            <p class="note__label">Now</p>
            <p class="now__role">
              <strong>{current.role}</strong> @ {current.org}
            </p>
            {current.highlights[0] && <p class="note__small">{current.highlights[0]}</p>}
            {profile.identity.open_to && <p class="note__small note__open">📬 {profile.identity.open_to}</p>}
          </article>
        )
      }

      {
        builds.length > 0 && (
          <article class="note note--builds">
            <p class="note__label">Featured builds</p>
            <ul class="clean builds">
              {builds.map((p) => (
                <li>
                  <a href={`/projects/${p.id}`}>{p.short}</a>
                  <span class="note__small">{p.tagline}</span>
                </li>
              ))}
            </ul>
            <a class="note__more" href="/dev">All projects at the Dev Center →</a>
          </article>
        )
      }

      {
        toolbelt.length > 0 && (
          <article class="note note--stack">
            <p class="note__label">Toolbelt</p>
            <ul class="stack-chips">
              {toolbelt.map((s) => (
                <StackChip name={s} />
              ))}
            </ul>
          </article>
        )
      }

      <article class="note note--music" data-on-repeat>
        <p class="note__label">On repeat</p>
        <dl class="repeat" data-repeat-list>
          <div><dt>Top song</dt><dd data-top-song>…</dd></div>
          <div><dt>Top artist</dt><dd data-top-artist>…</dd></div>
        </dl>
        <a class="note__more" href="/music">More at Crate &amp; Closet →</a>
      </article>
    </div>
  </section>

  <nav class="signpost" aria-labelledby="where-title">
    <h2 id="where-title" class="signpost__title">Where to?</h2>
    <ul class="clean signpost__list">
      {
        destinations.map((p, i) => (
          <li>
            <a href={p.href} class:list={["plank", { "plank--left": i % 2 === 1 }]}>
              <span class="plank__emoji" aria-hidden="true">{p.emoji}</span>
              <span class="plank__name">{p.name}</span>
              <span class="plank__blurb">{p.blurb}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <p class="hint">
    <span class="only-wide">Walk with WASD or the arrow keys, or click anywhere.</span>
    <span class="only-narrow">Tap the town to walk, or pick a sign.</span>
  </p>
</TownLayout>

<script>
  import { h, loadStats } from "../lib/stats-client";

  // Top song and artist from the same cached Spotify stats as Crate & Closet.
  document.addEventListener("astro:page-load", async () => {
    const root = document.querySelector<HTMLElement>("[data-on-repeat]");
    if (!root || root.dataset.rendered) return;
    root.dataset.rendered = "1";
    const sp = (await loadStats())?.spotify;
    const song = sp?.topTracks[0];
    const artist = sp?.topArtists[0];
    if (!song && !artist) {
      root.querySelector("[data-repeat-list]")!.replaceWith(h("p", { class: "note__small" }, "📻 The radio's quiet right now."));
      return;
    }
    const link = (url: string, ...text: (Node | string)[]) => h("a", { href: url, target: "_blank", rel: "noopener noreferrer" }, ...text);
    root.querySelector("[data-top-song]")!.replaceChildren(song ? link(song.url, h("strong", {}, song.name), ` by ${song.artists}`) : "—");
    root.querySelector("[data-top-artist]")!.replaceChildren(artist ? link(artist.url, h("strong", {}, artist.name)) : "—");
  });
</script>

<style>
  /* The town square is outdoors: the panel is a patch of the same grass, with the town hall's board on it. */
  :global(html[data-place="town"] .panel__body) {
    background:
      linear-gradient(45deg, rgba(0, 0, 0, 0.04) 25%, transparent 25% 75%, rgba(0, 0, 0, 0.04) 75%) 0 0 / 16px 16px,
      var(--grass);
  }

  /* ─────────────── the board: a wooden frame around cork ─────────────── */
  .board {
    position: relative;
    margin-top: 0.9rem;
    padding: 2.2rem 0.75rem 0.75rem;
    background: #8a5a34;
    border: 3px solid var(--ink);
    border-radius: 6px;
    box-shadow:
      inset 0 0 0 3px #a8703f,
      0 5px 0 var(--ink);
  }
  .board__plank {
    position: absolute;
    top: -0.9rem;
    left: 50%;
    translate: -50% 0;
    margin: 0;
    padding: 0.55rem 1rem;
    white-space: nowrap;
    font: 400 0.62rem/1 var(--font-retro, monospace);
    text-transform: uppercase;
    color: var(--cream);
    background: #6b4226;
    border: 3px solid var(--ink);
    border-radius: 4px;
    box-shadow: 0 3px 0 var(--ink);
  }
  .cork {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 0.9rem;
    padding: 1.1rem 0.9rem 1rem;
    background:
      radial-gradient(rgba(90, 55, 25, 0.25) 1px, transparent 1.5px) 0 0 / 7px 7px,
      #d9a86c;
    border: 3px solid #5e3b20;
  }

  /* ─────────────── pinned notes ─────────────── */
  .note {
    position: relative;
    padding: 1.1rem 0.85rem 0.8rem;
    background: var(--cream);
    border: 2px solid var(--ink);
    box-shadow: 3px 3px 0 rgba(59, 47, 42, 0.45);
    rotate: -0.6deg;
    min-width: 0;
  }
  .note:nth-child(even) {
    rotate: 0.7deg;
  }
  .note::before {
    content: "";
    position: absolute;
    top: -7px;
    left: 50%;
    width: 12px;
    height: 12px;
    translate: -50% 0;
    background: var(--coral);
    border: 2px solid var(--ink);
    border-radius: 50%;
  }
  .note > :last-child {
    margin-bottom: 0;
  }
  .note__label {
    margin: 0 0 0.5rem;
    font: 400 0.55rem/1.4 var(--font-retro, monospace);
    text-transform: uppercase;
    color: var(--coral-ink);
  }
  .note__small {
    display: block;
    margin: 0 0 0.4rem;
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--ink-soft);
  }
  .note__more {
    display: inline-block;
    margin-top: 0.3rem;
    font-size: 0.85rem;
  }

  .note--mayor {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.4rem 1rem;
    background: var(--paper);
    rotate: 0deg;
  }
  .note--mayor :global(.mayor__avatar) {
    width: 104px;
    height: 104px;
    border: 3px solid var(--ink);
  }
  .mayor__name {
    margin: 0 0 0.3rem;
    font: 400 clamp(1rem, 2vw, 1.35rem) / 1.3 var(--font-retro, monospace);
  }
  .mayor__name:focus {
    outline: none;
  }
  .mayor__role {
    margin: 0;
    font: 1.35rem/1.1 var(--font-terminal, monospace);
    color: var(--teal-ink);
  }
  .mayor__tagline {
    grid-column: 1 / -1;
    margin: 0.4rem 0 0;
    font-size: 1.05rem;
  }
  .mayor__credits {
    grid-column: 1 / -1;
    margin: 0;
    padding-top: 0.45rem;
    border-top: 2px dashed var(--line);
    font: 400 0.5rem/1.7 var(--font-retro, monospace);
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .now__role {
    margin: 0 0 0.4rem;
  }
  .note__open {
    color: var(--teal-ink);
  }

  .note--builds {
    background: #fff3c4;
  }
  .builds {
    display: grid;
    gap: 0.45rem;
  }
  .builds a {
    font-weight: 700;
  }
  .builds .note__small {
    margin: 0;
  }

  .note--stack {
    background: #e3f4fb;
  }
  .note--stack .stack-chips {
    margin: 0;
  }

  .note--music {
    background: #ffe1d6;
  }
  .note--music::before {
    background: var(--teal);
  }
  .repeat {
    display: grid;
    gap: 0.45rem;
    margin: 0 0 0.3rem;
  }
  .repeat dt {
    font: 400 0.48rem/1.4 var(--font-retro, monospace);
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .repeat dd {
    margin: 0;
    line-height: 1.35;
  }
  .repeat :global(a) {
    color: var(--ink);
  }

  /* ─────────────── the signpost: one wooden plank per place ─────────────── */
  .signpost {
    position: relative;
    margin-top: 1.5rem;
    padding: 0 0 0.5rem;
  }
  .signpost::before {
    content: "";
    position: absolute;
    top: 1.5rem;
    bottom: 0;
    left: 50%;
    width: 14px;
    translate: -50% 0;
    background: #6b4226;
    border: 3px solid var(--ink);
  }
  .signpost__title {
    position: relative;
    width: max-content;
    margin: 0 auto 0.75rem;
    padding: 0.5rem 0.9rem;
    font: 400 0.65rem/1 var(--font-retro, monospace);
    text-transform: uppercase;
    color: var(--ink);
    background: var(--sun);
    border: 3px solid var(--ink);
    box-shadow: 0 3px 0 var(--ink);
  }
  .signpost__list {
    position: relative;
    display: grid;
    gap: 0.55rem;
  }
  .plank {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: baseline;
    gap: 0.6rem;
    width: min(100%, 30rem);
    margin-left: auto;
    padding: 0.5rem 2rem 0.5rem 0.9rem;
    color: var(--cream);
    text-decoration: none;
    background: #a8703f;
    border: 3px solid var(--ink);
    box-shadow: 0 3px 0 var(--ink);
    clip-path: polygon(0 0, calc(100% - 1.3rem) 0, 100% 50%, calc(100% - 1.3rem) 100%, 0 100%);
    transition: translate 0.1s steps(2);
  }
  .plank--left {
    margin: 0 auto 0 0;
    padding: 0.5rem 0.9rem 0.5rem 2rem;
    clip-path: polygon(1.3rem 0, 100% 0, 100% 100%, 1.3rem 100%, 0 50%);
  }
  .plank:hover,
  .plank:focus-visible {
    background: #c0844d;
    translate: 4px 0;
  }
  .plank--left:hover,
  .plank--left:focus-visible {
    translate: -4px 0;
  }
  .plank__emoji {
    align-self: center;
  }
  .plank__name {
    font: 400 0.6rem/1.4 var(--font-retro, monospace);
    text-transform: uppercase;
    white-space: nowrap;
  }
  .plank__blurb {
    font-size: 0.85rem;
    line-height: 1.3;
    color: #fbe7cf;
  }

  .hint {
    margin: 1rem 0 0;
    text-align: center;
    font: 400 0.5rem/1.6 var(--font-retro, monospace);
    text-transform: uppercase;
    color: #24521a;
  }
  .only-narrow {
    display: none;
  }
  @media (max-width: 899px), (pointer: coarse) {
    .only-wide {
      display: none;
    }
    .only-narrow {
      display: inline;
    }
  }

  @media (max-width: 1100px) {
    .cork {
      grid-template-columns: minmax(0, 1fr);
    }
    .note,
    .note:nth-child(even) {
      rotate: 0deg;
    }
  }
  /* The panel is a small peek card over the town here. */
  @media (max-width: 899px) {
    .note--mayor :global(.mayor__avatar) {
      width: 64px;
      height: 64px;
    }
    .plank {
      grid-template-columns: auto 1fr;
    }
    .plank__blurb {
      grid-column: 2;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .plank {
      transition: none;
    }
  }
</style>
