---
import TownLayout from "../layouts/TownLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { profile } from "../lib/profile";

const first = profile.identity.short_name;
const featured = profile.projects.find((p) => p.featured);
const suggestions = [
  "What projects have you worked on?",
  "Tell me about your experience.",
  "What technologies do you use?",
  "What are you interested in outside of tech?",
  "When are you free for a quick chat?",
  featured ? `Tell me about ${featured.title}.` : "What are you working on now?",
];
---

<TownLayout place="twin" title="Digital Twin" description={`Ask ${first}'s AI twin about projects, experience, and interests.`}>
  <PageHeader kicker="💬 Town Plaza" title={`Chat with ${first}'s digital twin`}>
    <p class="muted twin-intro">
      I'm an AI version of {first}, grounded only in {first}'s profile. I might not know everything, and I'll say so when I don't.
    </p>
  </PageHeader>

  <section class="chat" data-chat data-first={first} aria-label="Conversation">
    <ol class="clean chat__log" data-log aria-live="polite" aria-relevant="additions">
      <li class="msg msg--twin">Hey! 👋 Ask me anything about my work, projects, or interests.</li>
    </ol>

    <div class="chat__suggest" data-suggest>
      <p class="muted chat__suggest-label">Try asking:</p>
      <ul class="clean chips">
        {suggestions.map((s) => <li><button type="button" class="chip suggestion" data-prompt={s}>{s}</button></li>)}
      </ul>
    </div>

    <form class="chat__form" data-form>
      <label for="chat-input" class="visually-hidden">Your question</label>
      <textarea id="chat-input" name="q" rows="2" maxlength="1500" placeholder="Ask me something…" required></textarea>
      <div class="chat__actions">
        <div class="chat__toggles">
          <label class="mode">
            <input type="checkbox" name="deep" /> Think harder
          </label>
          <button type="button" class="btn btn--small voice" data-voice aria-pressed="false" title="Read replies aloud">🔇 Voice off</button>
        </div>
        <button class="btn btn--teal" type="submit" data-send>Send</button>
      </div>
      <div data-turnstile></div>
    </form>
    <p class="muted fine">
      Messages are sent to an AI model via OpenRouter to generate replies, and spoken replies are generated the same way. Please don't share personal information in chat. Meeting requests go to {first} directly, never to the AI.
    </p>
  </section>
</TownLayout>

<script>
  import { setupChat } from "../twin/chat.ts";

  document.addEventListener("astro:page-load", () => {
    const root = document.querySelector<HTMLElement>("[data-chat]");
    if (root) setupChat(root);
  });
</script>

<style is:global>
  .twin-intro {
    font-size: 0.92rem;
  }
  .chat__log {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }
  .chat .msg {
    max-width: 88%;
    padding: 0.6rem 0.9rem;
    border-radius: 16px;
    border: 2px solid var(--line);
    background: var(--paper);
    white-space: pre-wrap;
  }
  .chat .msg p {
    margin: 0 0 0.5em;
    white-space: normal;
  }
  .chat .msg p:last-child {
    margin: 0;
  }
  .chat .msg ul {
    margin: 0.25em 0;
    padding-left: 1.1rem;
    white-space: normal;
  }
  .chat .msg--twin {
    align-self: flex-start;
    border-bottom-left-radius: 4px;
  }
  .chat .msg--user {
    align-self: flex-end;
    background: var(--teal);
    border-color: var(--teal);
    color: #fff;
    border-bottom-right-radius: 4px;
  }
  .chat .msg--typing > div:empty::after {
    content: "…";
    animation: blink 1s steps(3) infinite;
  }
  .chat .msg--error {
    border-color: var(--coral);
    background: #fff1ec;
  }
  @keyframes blink {
    50% {
      opacity: 0.3;
    }
  }
  .chat__suggest-label {
    margin: 0 0 0.35rem;
    font-size: 0.85rem;
  }
  .chat .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }
  .chat .suggestion {
    border: 2px solid var(--line);
    font: inherit;
    font-size: 0.85rem;
    padding: 0.35em 0.8em;
    min-height: 36px;
    cursor: pointer;
    text-align: left;
  }
  .chat .suggestion:hover {
    border-color: var(--ink);
  }
  .chat__form textarea {
    width: 100%;
    font: inherit;
    padding: 0.7rem 0.9rem;
    border: 2px solid var(--ink);
    border-radius: 14px;
    background: var(--paper);
    resize: vertical;
  }
  .chat__actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.5rem;
  }
  .chat__toggles {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.9rem;
  }
  .chat .voice {
    font-size: 0.85rem;
  }
  .chat .voice[aria-pressed="true"] {
    background: var(--sun);
  }
  .chat .slots {
    margin-top: 0.6rem;
    white-space: normal;
  }
  .chat .slots__label {
    margin: 0 0 0.35rem;
    font-size: 0.82rem;
  }
  .chat .slots .chips {
    margin-bottom: 0.4rem;
  }
  .chat .slot {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    background: var(--paper);
  }
  .chat .slot[aria-pressed="true"] {
    border-color: var(--ink);
    background: var(--sand);
  }
  .chat .slot__et {
    font-size: 0.75rem;
    opacity: 0.75;
  }
  .chat .book {
    display: grid;
    gap: 0.5rem;
    padding: 0.75rem;
    border: 2px dashed var(--line);
    border-radius: 12px;
  }
  .chat .book__title {
    margin: 0;
  }
  .chat .book__field {
    display: grid;
    gap: 0.2rem;
    font-size: 0.85rem;
  }
  .chat .book__field input,
  .chat .book__field textarea {
    font: inherit;
    padding: 0.45rem 0.65rem;
    border: 2px solid var(--ink);
    border-radius: 10px;
    background: #fff;
    min-height: 40px;
  }
  .chat .book__actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
  }
  .chat .book__status {
    margin: 0;
    font-size: 0.85rem;
  }
  .chat .book__status:empty {
    display: none;
  }
  .chat .book__status--error {
    color: var(--coral);
  }
  .chat .book__done {
    margin: 0;
    padding: 0.6rem 0.75rem;
    border: 2px solid var(--teal);
    border-radius: 12px;
  }
  .chat .mode {
    font-size: 0.9rem;
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    min-height: 44px;
  }
  .chat .fine {
    font-size: 0.78rem;
    margin-top: 1rem;
  }
</style>
