---
import TownLayout from "../layouts/TownLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import TwinChat from "../components/TwinChat.astro";
import { profile } from "../lib/profile";

const first = profile.identity.short_name;
const handle = `${first.toLowerCase()}_twin`;
const featured = profile.projects.find((p) => p.featured);
const suggestions = [
  "What projects have you worked on?",
  "Tell me about your experience.",
  "What technologies do you use?",
  "What are you interested in outside of tech?",
  "When are you free for a quick chat?",
  featured ? `Tell me about ${featured.title}.` : "What are you working on now?",
];
const chat = {
  persona: "twin",
  first,
  speaker: "The twin",
  handle,
  icon: "💬",
  greeting: "Hey! 👋 Ask me anything about my work, projects, or interests.",
  suggestions,
  placeholder: "Ask me something…",
  cam: true,
} as const;
---

<TownLayout place="twin" title="Digital Twin" description={`Ask ${first}'s AI twin about projects, experience, and interests.`}>
  <div class="twin-head">
    <PageHeader kicker="💬 Town Plaza" title={`Chat with ${first}'s digital twin`}>
      <p class="muted twin-intro">
        I'm an AI version of {first}, grounded only in {first}'s profile. I might not know everything, and I'll say so when I don't.
      </p>
    </PageHeader>
  </div>

  <TwinChat {...chat} />
  <p class="muted fine twin-fine">
    Messages are sent to an AI model via OpenRouter to generate replies, and spoken replies are generated the same way. Please don't share personal information in chat. Meeting requests go to {first} directly, never to the AI.
  </p>
</TownLayout>

<script>
  import { setupChat } from "../twin/chat.ts";
  import { PovView, WEBCAM } from "../town/pov.ts";

  let cam: PovView | null = null;
  document.addEventListener("astro:page-load", () => {
    // Only the twin's chat: LeBronette's, at the Dev Center, is set up by that page.
    const root = document.querySelector<HTMLElement>('[data-chat][data-persona="twin"]');
    if (!root) return;
    setupChat(root);
    cam?.destroy();
    cam = null;
    const canvas = root.querySelector<HTMLCanvasElement>("[data-twin-cam]");
    if (!canvas) return;
    cam = new PovView(canvas, "couch", { focus: WEBCAM });
    cam.start();
  });
  document.addEventListener("astro:before-swap", () => {
    cam?.destroy();
    cam = null;
  });
</script>

<style is:global>
  /* The heading in arcade type, the intro as a terminal readout with a blinking cursor. */
  .twin-head h1 {
    font: 400 clamp(15px, 3.6vw, 22px) / 1.6 var(--font-retro, monospace);
    letter-spacing: 0;
    text-shadow: 3px 3px 0 var(--sun);
  }
  .twin-intro {
    font: 1.3rem/1.15 var(--font-terminal, monospace);
    letter-spacing: 0.02em;
  }
  .twin-intro::before {
    content: "> ";
    color: var(--teal-ink);
  }
  .twin-intro::after {
    content: "▮";
    margin-left: 0.2em;
    color: var(--teal-ink);
    animation: blink 1s steps(1) infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .twin-intro::after {
      animation: none;
    }
  }
  .twin-fine {
    font-size: 0.78rem;
    margin-top: 1.25rem;
  }
</style>
