---
import { Image } from "astro:assets";
import TownLayout from "../layouts/TownLayout.astro";
import PixelPortrait from "../components/PixelPortrait.astro";
import { profile } from "../lib/profile";
import { resolveImage } from "../lib/images";
import { externalLink } from "../lib/locations";

const first = profile.identity.short_name;
const djing = profile.interests.find((i) => i.id === "dj");
const fashion = profile.interests.find((i) => i.id === "fashion");
const depop = externalLink("depop");
const photos = (fashion?.images ?? []).flatMap((img) => {
  const src = resolveImage(img.src);
  return src ? [{ src, alt: img.alt }] : [];
});
---

<TownLayout
  place="music"
  room
  title="Crate & Closet"
  description={`${first}'s record shop and vintage closet: top tracks on the jukebox, top artists on the poster wall, a taste match at the crates, song requests at the DJ booth, and the fashion story.`}
>
  <div class="mcp mcp--shop">
    <header class="shop-id">
      <PixelPortrait class="shop-id__avatar" />
      <div class="shop-id__text">
        <p class="mcp-kicker">💿 Records · Vintage</p>
        <h1 id="panel-title" class="shop-sign" tabindex="-1">Crate &amp; Closet</h1>
      </div>
    </header>

    <p class="mcp-hint">
      Records up front, vintage in the back. {djing?.blurb}
      {fashion && " The closet, below, holds the fashion side."}
    </p>

    <section class="mcp-card" aria-labelledby="spin-title" data-spotify aria-busy="true" aria-live="polite">
      <h2 id="spin-title" class="mcp-h">Now spinning</h2>
      <p class="mcp-dim" data-spin>Warming up the tubes…</p>
      <div class="mcp-fastlane">
        <button type="button" class="mcp-btn mcp-btn--primary" data-open="jukebox">🎵 Jukebox</button>
        <button type="button" class="mcp-btn" data-open="posters">🎸 Gig posters</button>
        <button type="button" class="mcp-btn" data-open="match">💿 Crate Match</button>
        <button type="button" class="mcp-btn" data-open="request">📞 Request line</button>
        {fashion && <a class="mcp-btn" href="#closet" data-closet-link>🧥 The Closet</a>}
      </div>
    </section>

    {
      fashion && (
        <section class="mcp-card closet" id="closet" aria-labelledby="closet-title" tabindex="-1">
          <h2 id="closet-title" class="mcp-h">The Closet</h2>
          <h3 class="closet__title">{fashion.title}</h3>
          <p>{fashion.blurb}</p>
          {fashion.details.length > 0 && (
            <ul class="closet__tags">
              {fashion.details.map((d) => (
                <li>{d}</li>
              ))}
            </ul>
          )}
          {photos.length > 0 && (
            <ul class="clean polaroids">
              {photos.map((p) => (
                <li class="polaroid">
                  <Image src={p.src} alt={p.alt} width={480} height={360} loading="lazy" />
                  <span class="polaroid__caption" aria-hidden="true">
                    {p.alt}
                  </span>
                </li>
              ))}
            </ul>
          )}
          <p class="closet__links">
            {fashion.links.map((l) => (
              <a class="mcp-btn" href={l.url} target="_blank" rel="noopener noreferrer">
                {l.label} ↗
              </a>
            ))}
            {depop?.url && (
              <a class="mcp-btn" href={depop.url} target="_blank" rel="noopener noreferrer">
                Shop my Depop ↗
              </a>
            )}
          </p>
        </section>
      )
    }
  </div>

  <!-- ─────────── the jukebox: top tracks, and a Spotify player in its window ─────────── -->
  <dialog slot="screen" class="mc mc--shop" data-shop-dialog="jukebox" aria-labelledby="shop-jukebox-title">
    <div class="mc__bar">
      <h2 id="shop-jukebox-title" class="mc__title">Jukebox</h2>
      <button type="button" class="mc__close" data-mc-close aria-label="Close the jukebox">✕</button>
    </div>
    <div class="mc__body">
      <div class="jukebox">
        <p class="jukebox__crown">{first}'s Jukebox</p>
        <div class="jukebox__window" data-jukebox-player>
          <p class="jukebox__idle">Pick a record ↓</p>
        </div>
        <ol class="clean jukebox__strips" data-jukebox-strips aria-label="Top tracks this month">
          <li class="jukebox__empty">The jukebox is being restocked. Check back soon.</li>
        </ol>
        <div class="jukebox__grille" aria-hidden="true"></div>
      </div>
      <p class="mc__fine">
        Top tracks from the last month on Spotify. Logged out, Spotify plays 30-second previews; logged in, whole songs. The music keeps playing while you
        look around the shop.
      </p>
    </div>
  </dialog>

  <!-- ─────────── the gig poster wall: top artists ─────────── -->
  <dialog slot="screen" class="mc mc--shop" data-shop-dialog="posters" aria-labelledby="shop-posters-title">
    <div class="mc__bar">
      <h2 id="shop-posters-title" class="mc__title">Gig posters</h2>
      <button type="button" class="mc__close" data-mc-close aria-label="Close the poster wall">✕</button>
    </div>
    <div class="mc__body">
      <ul class="clean bins" data-bins aria-label="Top genres"></ul>
      <ol class="clean gigs" data-gigs aria-label="Top artists">
        <li class="mc__fine">The posters are still at the printer. Check back soon.</li>
      </ol>
      <p class="mc__fine">Most-played artists over the last six months on Spotify.</p>
    </div>
  </dialog>

  <!-- ─────────── the record crates: Crate Match ─────────── -->
  <dialog slot="screen" class="mc mc--shop" data-shop-dialog="match" data-first={first} aria-labelledby="shop-match-title">
    <div class="mc__bar">
      <h2 id="shop-match-title" class="mc__title">Crate Match</h2>
      <button type="button" class="mc__close" data-mc-close aria-label="Close Crate Match">✕</button>
    </div>
    <div class="mc__body" data-match>
      <form class="crate" data-match-form>
        <p class="crate__lead">Who's in your crate? Pick three to five artists you love, and see how close your taste is to {first}'s.</p>
        <label class="visually-hidden" for="match-search">Search for an artist</label>
        <input
          id="match-search"
          class="crate__search"
          type="search"
          autocomplete="off"
          data-match-search
          aria-expanded="false"
          aria-controls="match-results"
          placeholder="Search an artist you love…"
        />
        <ul id="match-results" class="clean picks" data-match-results aria-label="Artists found"></ul>
        <ul class="clean crate__picked" data-match-picked aria-label="Your crate"></ul>
        <details class="crate__lastfm">
          <summary>Use your Last.fm instead</summary>
          <label>
            Last.fm username
            <input name="lastfm" maxlength="15" autocomplete="off" spellcheck="false" data-match-lastfm placeholder="your username" />
          </label>
          <p class="mc__fine">Reads your public top artists from the last six months. Scrobbling Spotify to Last.fm counts.</p>
        </details>
        <div class="crate__go">
          <p class="crate__status" data-match-status role="status" aria-live="polite"></p>
          <button type="submit" class="mc-btn" data-match-go>💿 Dig</button>
        </div>
      </form>
      <div class="match" data-match-result hidden aria-live="polite"></div>
      <p class="mc__fine">
        Compared with {first}'s Spotify top artists: shared artists, close neighbours (Last.fm's similar artists) and the overall sound (Last.fm tags). Nothing
        you enter is saved.
      </p>
    </div>
  </dialog>

  <!-- ─────────── the DJ booth: the request line ─────────── -->
  <dialog slot="screen" class="mc mc--shop" data-shop-dialog="request" aria-labelledby="shop-request-title">
    <div class="mc__bar">
      <h2 id="shop-request-title" class="mc__title">Request line</h2>
      <button type="button" class="mc__close" data-mc-close aria-label="Close the request line">✕</button>
    </div>
    <div class="mc__body requests" data-request>
      <form class="request" data-request-form>
        <p class="crate__lead">Know a song {first} needs to hear? Call it in.</p>
        <label class="visually-hidden" for="request-search">Search for a song</label>
        <input
          id="request-search"
          class="crate__search"
          type="search"
          autocomplete="off"
          data-request-search
          aria-expanded="false"
          aria-controls="request-results"
          placeholder="Search a song…"
        />
        <div class="pick pick--chosen" data-request-chosen hidden></div>
        <ul id="request-results" class="clean picks" data-request-results aria-label="Songs found"></ul>
        <label class="request__field">
          Why this one?
          <textarea name="note" rows="3" maxlength="280" placeholder="optional: the bridge, the memory, the vibe"></textarea>
        </label>
        <label class="request__field">Your name <input name="name" maxlength="40" autocomplete="name" placeholder="optional" /></label>
        <!-- Honeypot: hidden from people, irresistible to bots. -->
        <label class="hp" aria-hidden="true">Website <input name="website" tabindex="-1" autocomplete="off" /></label>
        <div data-request-turnstile></div>
        <div class="crate__go">
          <p class="crate__status" data-request-status role="status" aria-live="polite"></p>
          <button type="submit" class="mc-btn" data-request-send>📞 Call it in</button>
        </div>
      </form>
      <section class="board" aria-labelledby="board-title">
        <h3 id="board-title" class="board__title">On the board</h3>
        <ul class="clean board__list" data-request-board></ul>
      </section>
      <p class="mc__fine">Requests are checked for spam by an AI model (Jev, via OpenRouter) and only go up on the board once {first} approves them.</p>
    </div>
  </dialog>
</TownLayout>

<script>
  import { navigate } from "astro:transitions/client";
  import type { SpotifyStats } from "@dan-town/api/types";
  import { fmtUpdated, h, loadStats } from "../lib/stats-client";
  import { objectRect, zoomIn } from "../town/zoom";
  import { fromShareParam, setupMatch } from "../shop/match";
  import { setupRequests } from "../shop/requests";

  /** Which room object each console zooms out of. */
  const OBJECT: Record<string, string> = { jukebox: "shop-jukebox", posters: "shop-posters", match: "crates", request: "decks" };
  /** A console (or the closet) asked for before the Crate & Closet page was shown (it opens once the page loads). */
  let pending: string | null = null;

  type Track = SpotifyStats["topTracks"][number];

  /** "https://open.spotify.com/track/<id>" → "<id>", or null for a link without one. */
  const trackId = (url: string) => url.match(/open\.spotify\.com\/track\/([A-Za-z0-9]+)/)?.[1] ?? null;

  function open(name: string) {
    const dialog = document.querySelector<HTMLDialogElement>(`[data-shop-dialog="${name}"]`);
    if (!dialog) {
      pending = name;
      void navigate("/music");
      return;
    }
    if (dialog.open) return;
    const from = objectRect(OBJECT[name]!);
    dialog.showModal();
    zoomIn(dialog, from);
  }

  for (const [name, id] of Object.entries(OBJECT)) document.addEventListener(`town:${id}`, () => open(name));

  /** The rack and the polaroids: no console, just bring the closet in the panel into view. */
  function showCloset() {
    const closet = document.querySelector<HTMLElement>("#closet");
    if (!closet) {
      pending = "closet";
      void navigate("/music");
      return;
    }
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    closet.scrollIntoView({ behavior: still ? "auto" : "smooth", block: "start" });
    closet.focus({ preventScroll: true });
    if (!still) closet.animate([{ boxShadow: "0 0 0 3px #ff6fae, 0 0 24px #ff6fae" }, { boxShadow: "4px 4px 0 #0d0808" }], { duration: 1200, easing: "ease-out" });
  }
  document.addEventListener("town:shop-closet", showCloset);

  /** Drop the needle: load Spotify's player for a track into `into` (the jukebox window, a match's deck). */
  function embed(url: string, title: string, into: Element) {
    const id = trackId(url);
    if (!id) return;
    const frame = h("iframe", {
      src: `https://open.spotify.com/embed/track/${id}?utm_source=generator&theme=0`,
      title: `${title}, on Spotify`,
      allow: "autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture",
      loading: "lazy",
      height: "152",
      class: "spotify-embed",
    });
    into.replaceChildren(frame);
  }

  function play(t: Track, strip: HTMLButtonElement) {
    for (const s of document.querySelectorAll<HTMLButtonElement>("[data-strip]")) s.setAttribute("aria-pressed", String(s === strip));
    embed(t.url, `${t.name} by ${t.artists}`, document.querySelector("[data-jukebox-player]")!);
  }

  function renderJukebox(tracks: Track[]) {
    const strips = document.querySelector("[data-jukebox-strips]")!;
    strips.replaceChildren(
      ...tracks.map((t, i) => {
        const playable = !!trackId(t.url);
        const strip = h(
          "button",
          { type: "button", class: "strip", "data-strip": "", "aria-pressed": "false", disabled: playable ? undefined : "" },
          h("span", { class: "strip__code" }, `A${i + 1}`),
          h("span", { class: "strip__text" }, h("span", { class: "strip__song" }, t.name), h("span", { class: "strip__artist" }, t.artists)),
        );
        strip.addEventListener("click", () => play(t, strip));
        return h("li", {}, strip);
      }),
    );
  }

  function renderPosters(sp: SpotifyStats) {
    document.querySelector("[data-bins]")!.replaceChildren(...sp.topGenres.map((g) => h("li", { class: "bin" }, g)));
    document.querySelector("[data-gigs]")!.replaceChildren(
      ...sp.topArtists.map((a, i) =>
        h(
          "li",
          { class: "gig" },
          h(
            "a",
            { href: a.url, target: "_blank", rel: "noopener noreferrer", class: "gig__link" },
            h("span", { class: "gig__photo" }, a.image ? h("img", { src: a.image, alt: "", loading: "lazy", width: "320", height: "320" }) : h("span", { class: "gig__note", "aria-hidden": "true" }, "♪")),
            h("span", { class: "gig__no" }, `No. ${i + 1}`),
            h("strong", { class: "gig__name" }, a.name),
            a.genres.length ? h("span", { class: "gig__genres" }, a.genres.slice(0, 2).join(" · ")) : "",
          ),
        ),
      ),
    );
  }

  /** The panel's "now spinning" card: this month's #1, with its sleeve. */
  function renderSpin(root: HTMLElement, sp: SpotifyStats | null, updatedAt: string | null) {
    const spin = root.querySelector("[data-spin]")!;
    const top = sp?.topTracks[0];
    if (!top) {
      spin.replaceWith(h("p", { class: "mcp-dim" }, "📻 The radio is quiet right now. Browse the closet while the records restock."));
      return;
    }
    spin.replaceWith(
      h(
        "div",
        { class: "spin" },
        top.image ? h("img", { class: "spin__sleeve", src: top.image, alt: "", width: "72", height: "72" }) : h("span", { class: "spin__sleeve", "aria-hidden": "true" }, "♪"),
        h(
          "p",
          { class: "spin__text" },
          h("strong", {}, top.name),
          h("span", { class: "mcp-dim" }, top.artists),
          h("span", { class: "mcp-dim spin__updated" }, `#1 this month · ${fmtUpdated(updatedAt)}`),
        ),
      ),
    );
  }

  document.addEventListener("astro:page-load", async () => {
    const root = document.querySelector<HTMLElement>("[data-spotify]");
    if (!root || root.dataset.rendered) return;
    root.dataset.rendered = "1";

    for (const dialog of document.querySelectorAll<HTMLDialogElement>("[data-shop-dialog]")) {
      dialog.querySelector("[data-mc-close]")!.addEventListener("click", () => dialog.close());
      dialog.addEventListener("close", () => document.dispatchEvent(new CustomEvent("town:focus")));
      dialog.addEventListener("click", (e) => e.target === dialog && dialog.close());
    }
    for (const b of document.querySelectorAll<HTMLButtonElement>("[data-open]")) b.addEventListener("click", () => open(b.dataset.open!));
    document.querySelector("[data-closet-link]")?.addEventListener("click", (e) => {
      e.preventDefault();
      showCloset();
    });

    const matchRoot = document.querySelector<HTMLElement>("[data-match]")!;
    const first = matchRoot.closest("dialog")!.dataset.first ?? "Dan";
    const match = setupMatch(matchRoot, { first, site: location.origin, play: embed });
    setupRequests(document.querySelector<HTMLElement>("[data-request]")!);

    // A shared Crate Match link (/music?crate=…) runs that match; otherwise open whatever was asked for on the way in.
    const shared = fromShareParam(new URLSearchParams(location.search).get("crate"));
    if (shared) {
      open("match");
      match.run(shared);
    } else if (pending) {
      const name = pending;
      pending = null;
      if (name === "closet") showCloset();
      else open(name);
    }

    const stats = await loadStats();
    root.removeAttribute("aria-busy");
    const sp = stats?.spotify ?? null;
    renderSpin(root, sp, stats?.updatedAt ?? null);
    if (sp?.topTracks.length) renderJukebox(sp.topTracks);
    if (sp?.topArtists.length) renderPosters(sp);
  });
</script>

<style>
  /* The panel and its header use the console classes (global.css .mcp), in record-shop oxblood and mustard. */
  .shop-id {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .shop-id :global(.shop-id__avatar) {
    flex: none;
    width: 80px;
    height: 80px;
    border: 3px solid var(--mcp-cyan);
    box-shadow: 4px 4px 0 #0d0808;
    image-rendering: pixelated;
  }
  .shop-id__text {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
  }
  /* The neon sign over the door. */
  .shop-sign {
    font: 400 clamp(1.6rem, 3.4vw, 2.3rem) / 1.1 var(--font-neon, var(--font-retro, monospace));
    color: #ffd6ea;
    text-shadow:
      0 0 4px #ff6fae,
      0 0 12px #ff6fae,
      0 0 24px rgba(255, 111, 174, 0.6);
    animation: neon-flicker 7s infinite;
  }
  .shop-sign:focus {
    outline: none;
  }
  @keyframes neon-flicker {
    0%,
    91%,
    93%,
    95%,
    100% {
      opacity: 1;
    }
    92%,
    94% {
      opacity: 0.55;
    }
  }
  .mcp-hint,
  .mcp-dim {
    color: var(--mcp-dim);
  }
  .mcp-fastlane {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* "Now spinning": the sleeve, then the song. */
  :global(.spin) {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  :global(.spin__sleeve) {
    flex: none;
    width: 72px;
    height: 72px;
    display: grid;
    place-items: center;
    object-fit: cover;
    background: #0d0808;
    border: 2px solid #0d0808;
    box-shadow: 4px 4px 0 #0d0808;
  }
  :global(.spin__text) {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }
  :global(.spin__text strong) {
    color: #fff;
    font-weight: 400;
  }
  :global(.spin__updated) {
    font-size: 1rem;
  }

  /* ─────────── the jukebox: wood cabinet, chrome arch, glowing window, title strips ─────────── */
  .jukebox {
    display: grid;
    gap: 0.9rem;
    padding: 1.2rem 1rem 1rem;
    background: linear-gradient(90deg, #6e3a1c, #a65e30 18%, #8a4a24 50%, #a65e30 82%, #6e3a1c);
    border: 4px solid #d8d8e0;
    border-radius: 160px 160px 12px 12px;
    box-shadow:
      inset 0 0 0 4px #3a2015,
      4px 4px 0 #0d0808;
  }
  .jukebox__crown {
    margin: 0.4rem 0 0;
    text-align: center;
    font: 400 clamp(1.1rem, 3vw, 1.6rem) / 1.2 var(--font-neon, var(--font-retro, monospace));
    color: #ffe2a8;
    text-shadow:
      0 0 6px #ff8a3d,
      0 0 14px #ff8a3d;
  }
  .jukebox__window {
    min-height: 152px;
    display: grid;
    place-items: center;
    background: radial-gradient(circle at 50% 40%, #ffcf6b, #ff8a3d 60%, #b8521e);
    border: 3px solid #d8d8e0;
    border-radius: 12px;
    overflow: hidden;
  }
  .jukebox__window :global(iframe) {
    display: block;
    width: 100%;
    height: 152px;
    border: 0;
  }
  .jukebox__idle {
    margin: 0;
    font: 400 0.65rem/1.4 var(--font-retro, monospace);
    color: #3a2015;
  }
  .jukebox__strips {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr));
    gap: 0.4rem;
    padding: 0.6rem;
    background: #3a2015;
    border: 3px solid #d8d8e0;
  }
  .jukebox__empty {
    color: #f6e7c8;
  }
  :global(.strip) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    height: 100%;
    padding: 0.35rem 0.5rem;
    text-align: left;
    font: 1.15rem/1.05 var(--font-terminal, monospace);
    color: #2b1a10;
    background: #f6e7c8;
    border: 0;
    border-left: 6px solid #e0a526;
    cursor: pointer;
  }
  :global(.strip:hover),
  :global(.strip:focus-visible) {
    background: #ffe9b8;
  }
  :global(.strip[aria-pressed="true"]) {
    background: #ff6fae;
    border-left-color: #fff;
  }
  :global(.strip:disabled) {
    opacity: 0.55;
    cursor: default;
  }
  :global(.strip__code) {
    flex: none;
    font: 400 0.55rem/1 var(--font-retro, monospace);
    color: #7a2e2e;
  }
  :global(.strip__text) {
    display: grid;
    min-width: 0;
  }
  :global(.strip__song),
  :global(.strip__artist) {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  :global(.strip__artist) {
    font-size: 1rem;
    opacity: 0.75;
  }
  .jukebox__grille {
    height: 34px;
    background: repeating-linear-gradient(90deg, #d8d8e0 0 3px, #2a1a10 3px 9px);
    border: 3px solid #d8d8e0;
    border-radius: 4px;
  }

  /* ─────────── the gig poster wall: screen-printed duotones, pinned a little crooked ─────────── */
  .bins {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }
  /* Genres as the divider cards in a record bin. */
  :global(.bin) {
    padding: 0.35rem 0.6rem 0.25rem;
    font: 400 0.5rem/1.4 var(--font-retro, monospace);
    text-transform: uppercase;
    color: #2b1a10;
    background: #e0a526;
    border-radius: 6px 6px 0 0;
    box-shadow: 0 3px 0 #7a4f2a;
  }
  .gigs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 150px), 1fr));
    gap: 1.1rem;
    padding: 0.4rem;
  }
  :global(.gig) {
    --duo-light: #ffd23f;
    --duo-dark: #7a2e2e;
