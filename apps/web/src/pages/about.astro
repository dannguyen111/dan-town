---
import TownLayout from "../layouts/TownLayout.astro";
import LinkRow from "../components/LinkRow.astro";
import PixelPortrait from "../components/PixelPortrait.astro";
import StackChip from "../components/StackChip.astro";
import { profile } from "../lib/profile";

const edu = profile.education[0];
const current = profile.experience.find((e) => e.end === null);
/** On the living-room TV. */
const TV_VIDEO = "GWshHUF05DM";
const first = profile.identity.short_name;

// "B.S. in Computer Science and Mathematics" → "CS + Math"
const major = edu?.degree.replace(/^.*? in /, "").replace("Computer Science", "CS").replace(" and ", " + ").replace("Mathematics", "Math");
const stats = [
  edu?.rank && { k: "Rank", v: edu.rank },
  edu?.end && { k: "Class of", v: edu.end.slice(0, 4) },
  major && { k: "Major", v: major },
  { k: "Projects", v: String(profile.projects.length) },
  { k: "Roles", v: String(profile.experience.length) },
].filter((s): s is { k: string; v: string } => Boolean(s));

// School honors first (Summa, Phi Beta Kappa…), then awards.
const achievements = [...(edu?.honors ?? []), ...profile.honors.map((h) => h.title)];
const SHOWN = 5;

// A short loadout; the full stack lives in the Dev Center.
const LOADOUT = ["Python", "TypeScript", "Java", "Go", "LangChain", "LangGraph", "LlamaIndex", "PostgreSQL", "Docker", "AWS"];
const allSkills = new Set(profile.skills.flatMap((g) => g.items));
const equipped = LOADOUT.filter((s) => allSkills.has(s));
---

<TownLayout place="home" room title="About" description={profile.about.intro}>
  <div class="sheet">
    <header class="sheet-id">
      <PixelPortrait class="sheet-id__avatar" animate />
      <div>
        <h1 id="panel-title" class="sheet-id__name" tabindex="-1">{profile.identity.name}</h1>
        <dl class="sheet-id__meta">
          <div><dt>Class</dt><dd>{profile.identity.headline}</dd></div>
          {edu && <div><dt>Guild</dt><dd>{edu.school}</dd></div>}
        </dl>
      </div>
    </header>

    <p class="muted room-hint">
      You're in my living room. Look around: the flags, the bookshelf and the desk all have stories, the TV works, and you can leave me a note on the
      fridge.
    </p>

    <section class="sheet-box" aria-labelledby="bio-title">
      <h2 id="bio-title" class="sheet-label">Bio</h2>
      <p class="lead">{profile.about.intro}</p>
      {profile.about.paragraphs[0] && <p>{profile.about.paragraphs[0]}</p>}
    </section>

    <section class="sheet-box sheet-box--dark" aria-labelledby="stats-title">
      <h2 id="stats-title" class="sheet-label">Stats</h2>
      <dl class="stats">
        {
          stats.map((s) => (
            <div>
              <dt>{s.k}</dt>
              <dd>{s.v}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    {
      (current || profile.identity.open_to) && (
        <section class="sheet-box" aria-labelledby="quest-title">
          <h2 id="quest-title" class="sheet-label">Current quest</h2>
          {current && (
            <p class="quest">
              ▶ <strong>{current.role}</strong> @ {current.org}
            </p>
          )}
          {profile.identity.open_to && <p class="muted quest__open">📬 Open to: {profile.identity.open_to}</p>}
        </section>
      )
    }

    {
      achievements.length > 0 && (
        <section class="sheet-box" aria-labelledby="ach-title">
          <h2 id="ach-title" class="sheet-label">Achievements</h2>
          <ul class="clean achievements">
            {achievements.slice(0, SHOWN).map((a) => (
              <li>{a}</li>
            ))}
          </ul>
          {achievements.length > SHOWN && (
            <details class="achievements__more">
              <summary>Show all {achievements.length}</summary>
              <ul class="clean achievements">
                {achievements.slice(SHOWN).map((a) => (
                  <li>{a}</li>
                ))}
              </ul>
            </details>
          )}
        </section>
      )
    }

    {
      equipped.length > 0 && (
        <section class="sheet-box" aria-labelledby="eq-title">
          <h2 id="eq-title" class="sheet-label">Equipped</h2>
          <ul class="stack-chips">
            {equipped.map((s) => (
              <StackChip name={s} />
            ))}
          </ul>
          <p class="sheet-more">
            <a href="/dev">Full stack in the Dev Center →</a>
          </p>
        </section>
      )
    }

    {
      profile.interests.length > 0 && (
        <section class="sheet-box" aria-labelledby="side-title">
          <h2 id="side-title" class="sheet-label">Side quests</h2>
          <ul class="clean side-quests">
            {profile.interests.map((i) => (
              <li>
                <span aria-hidden="true">{i.emoji}</span> <a href="/music">{i.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="sheet-box" aria-labelledby="hi-title">
      <h2 id="hi-title" class="sheet-label">Say hi</h2>
      <LinkRow />
    </section>

    <p class="muted next">
      Next stop: the <a href="/dev">Dev Center</a> for my projects, experience and education, or the <a href="/lab">Research Lab</a> for my research.
    </p>
  </div>

  <!-- The TV, seen from the couch: the room around it, the video inside the set (town/pov.ts). -->
  <dialog slot="screen" class="pov-dialog" data-tv aria-labelledby="tv-title">
    <div class="pov">
      <canvas class="pov__canvas" aria-hidden="true" data-pov-canvas></canvas>
      <div class="pov__screen tv__screen" data-tv-screen></div>
      <div class="pov__bar">
        <h2 id="tv-title" class="pov__title">CH 23 · LeBron's most clutch moments</h2>
        <a class="pov__btn" href={`https://www.youtube.com/watch?v=${TV_VIDEO}`} target="_blank" rel="noopener noreferrer">YouTube ↗</a>
        <button class="pov__btn" type="button" data-tv-off>Turn off</button>
      </div>
    </div>
  </dialog>

  <!-- The computer, sitting down: the twin's live agent traces on the monitor (twin/traces.ts). -->
  <dialog slot="screen" class="pov-dialog" data-desk aria-labelledby="desk-title">
    <div class="pov">
      <canvas class="pov__canvas" aria-hidden="true" data-pov-canvas></canvas>
      <section class="pov__screen term" data-term aria-label="Agent traces"></section>
      <div class="pov__bar">
        <h2 id="desk-title" class="pov__title">Computer · how the twin answered, live</h2>
        <a class="pov__btn" href="/twin" data-desk-ask>Ask the twin</a>
        <button class="pov__btn" type="button" data-desk-off>Stand up</button>
      </div>
      <p class="pov__fine">Only timings, token counts and tool names are kept. Never what anyone asked or what the twin said.</p>
    </div>
  </dialog>

  <dialog slot="screen" class="fridge" data-fridge aria-labelledby="fridge-title">
    <div class="fridge__door">
      <span class="fridge__handle" aria-hidden="true"></span>
      <div class="fridge__top">
        <h2 id="fridge-title" class="fridge__title">The fridge</h2>
        <button class="fridge__btn" type="button" data-fridge-close aria-label="Close the fridge">✕</button>
      </div>

      <ul class="fridge__notes" data-fridge-notes aria-label="Notes pinned by visitors"></ul>

      <form class="fridge__form note note--new" data-fridge-form>
        <span class="magnet" aria-hidden="true"></span>
        <label class="visually-hidden" for="fridge-message">Your note</label>
        <textarea id="fridge-message" name="message" rows="4" maxlength="600" required placeholder={`Leave ${first} a note: say hi, pitch a collab, or tell him about a role…`}></textarea>
        <div class="fridge__row">
          <label>Name <input name="name" maxlength="40" autocomplete="name" placeholder="optional" /></label>
          <label>Reply to <input name="contact" maxlength="120" autocomplete="email" placeholder="email or link, optional" /></label>
        </div>
        <!-- Honeypot: hidden from people, irresistible to bots. -->
        <label class="hp" aria-hidden="true">Website <input name="website" tabindex="-1" autocomplete="off" /></label>
        <div data-fridge-turnstile></div>
        <div class="fridge__row fridge__row--end">
          <p class="fridge__status" data-fridge-status role="status" aria-live="polite"></p>
          <button class="fridge__btn fridge__btn--pin" type="submit" data-fridge-send>📌 Pin it</button>
        </div>
      </form>
      <p class="fridge__fine">
        Notes are sorted by an AI model (Jev, TypeSafe's decision model, via OpenRouter) and only go up on the fridge once {first} approves them. Your reply-to details are only shown to {first}.
      </p>
    </div>
  </dialog>
</TownLayout>

<script>
  import { navigate } from "astro:transitions/client";
  import { formatEastern } from "../town/home";
  import { PovView } from "../town/pov";
  import { objectRect, zoomIn } from "../town/zoom";
  import { TraceTerminal } from "../twin/traces";
  import type { FridgeNote, FridgeTopic } from "@dan-town/api/types";

  const VIDEO = "GWshHUF05DM";
  /** The TV was turned on from another page beside the room (the twin's chat). */
  let pending = false;

  // The TV in the living room, seen from the couch. The YouTube player only loads once someone
  // turns the TV on, and is removed again when they turn it off, so the room costs nothing until then.
  let tvView: PovView | null = null;
  function turnOn(tv: HTMLDialogElement) {
    if (tv.open) return;
    const from = objectRect("tv");
    const frame = document.createElement("iframe");
    frame.src = `https://www.youtube-nocookie.com/embed/${VIDEO}?autoplay=1&rel=0&playsinline=1`;
    frame.title = "LeBron James' Most Clutch Moments, on YouTube";
    frame.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
    frame.allowFullscreen = true;
    frame.referrerPolicy = "strict-origin-when-cross-origin";
    const screen = tv.querySelector<HTMLElement>("[data-tv-screen]")!;
    screen.replaceChildren(frame);
    tv.showModal();
    tvView = new PovView(tv.querySelector("canvas")!, "tv", { overlay: screen });
    tvView.start();
    zoomIn(tv, from);
  }

  document.addEventListener("town:tv", () => {
    const tv = document.querySelector<HTMLDialogElement>("[data-tv]");
    if (tv) return turnOn(tv);
    pending = true;
    void navigate("/about");
  });

  // The computer: sit down and the monitor shows the twin's agent traces, updating live.
  let deskPending = false;
  let deskView: PovView | null = null;
  let terminal: TraceTerminal | null = null;
  function sitDown(desk: HTMLDialogElement) {
    if (desk.open) return;
    const from = objectRect("desk");
    desk.showModal();
    const screen = desk.querySelector<HTMLElement>("[data-term]")!;
    deskView = new PovView(desk.querySelector("canvas")!, "desk", { overlay: screen });
    deskView.start();
    terminal = new TraceTerminal(screen);
    terminal.start();
    zoomIn(desk, from);
  }

  document.addEventListener("town:desk", () => {
    const desk = document.querySelector<HTMLDialogElement>("[data-desk]");
    if (desk) return sitDown(desk);
    deskPending = true;
    void navigate("/about");
  });

  document.addEventListener("astro:page-load", () => {
    const tv = document.querySelector<HTMLDialogElement>("[data-tv]");
    const desk = document.querySelector<HTMLDialogElement>("[data-desk]");
    if (!tv || !desk) return;
    // Removing the player stops the video. Escape closes the dialog without a click, hence "close" too.
    const turnOff = () => {
      tv.querySelector("[data-tv-screen]")!.replaceChildren();
      tvView?.destroy();
      tvView = null;
      if (tv.open) tv.close();
    };
    tv.querySelector("[data-tv-off]")!.addEventListener("click", turnOff);
    tv.addEventListener("close", () => {
      turnOff();
      document.dispatchEvent(new CustomEvent("town:focus"));
    });

    const standUp = () => {
      terminal?.stop();
      terminal = null;
      deskView?.destroy();
      deskView = null;
      if (desk.open) desk.close();
    };
    desk.querySelector("[data-desk-off]")!.addEventListener("click", standUp);
    // Asking the twin opens the chat beside the room; leave the desk first.
    desk.querySelector("[data-desk-ask]")!.addEventListener("click", standUp);
    desk.addEventListener("close", () => {
      standUp();
      document.dispatchEvent(new CustomEvent("town:focus"));
    });

    if (pending) {
      pending = false;
      turnOn(tv);
    }
    if (deskPending) {
      deskPending = false;
      sitDown(desk);
    }
  });

  // ───────────── the fridge: visitors pin notes for Dan ─────────────
  const SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
  const TOPIC: Record<FridgeTopic, string> = { hiring: "💼 hiring", collab: "🤝 collab", hi: "👋 hi", unsorted: "📝 note" };
  let fridgePending = false;
  let turnstile: { id?: string; token?: string; cb?: (t: string) => void } = {};

  /** The human check, loaded only once someone pins a note. Resolves with a fresh token. */
  async function turnstileToken(container: HTMLElement): Promise<string | undefined> {
    if (!SITE_KEY) return undefined;
    if (turnstile.token) return turnstile.token;
    const ts = () => (window as any).turnstile;
    if (!ts()) {
      await new Promise<void>((resolve, reject) => {
        const s = document.createElement("script");
        s.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
        s.onload = () => resolve();
        s.onerror = () => reject(new Error("Couldn't load the human check. Try again?"));
        document.head.append(s);
      });
    }
    return new Promise((resolve) => {
      const callback = (t: string) => resolve((turnstile.token = t));
      if (turnstile.id !== undefined && container.isConnected && container.childElementCount) ts().reset(turnstile.id);
      else turnstile.id = ts().render(container, { sitekey: SITE_KEY, size: "flexible", callback: (t: string) => turnstile.cb?.(t) });
      turnstile.cb = callback;
    });
  }

  function renderNotes(list: HTMLUListElement, notes: FridgeNote[]) {
    if (!notes.length) {
      const li = document.createElement("li");
      li.className = "fridge__empty";
      li.textContent = "Nothing pinned yet. Be the first!";
      return list.replaceChildren(li);
    }
    list.replaceChildren(
      ...notes.map((n, i) => {
        const li = document.createElement("li");
        li.className = `note note--${n.topic}`;
        li.style.setProperty("--tilt", `${((i * 7) % 5) - 2}deg`);
        const magnet = document.createElement("span");
        magnet.className = "magnet";
        magnet.setAttribute("aria-hidden", "true");
        const text = document.createElement("p");
        text.textContent = n.message;
        const meta = document.createElement("p");
        meta.className = "note__meta";
        meta.textContent = `${n.name ? `— ${n.name}` : "— a visitor"} · ${TOPIC[n.topic] ?? TOPIC.unsorted}`;
        li.append(magnet, text, meta);
        return li;
      }),
    );
  }

  async function openFridge(fridge: HTMLDialogElement) {
    if (fridge.open) return;
    fridge.showModal();
    const list = fridge.querySelector<HTMLUListElement>("[data-fridge-notes]")!;
    try {
      const res = await fetch("/api/fridge");
      if (!res.ok) throw new Error();
      renderNotes(list, await res.json());
    } catch {
      list.replaceChildren();
    }
  }

  document.addEventListener("town:fridge", () => {
    const fridge = document.querySelector<HTMLDialogElement>("[data-fridge]");
    if (fridge) return void openFridge(fridge);
    fridgePending = true;
    void navigate("/about");
  });

  document.addEventListener("astro:page-load", () => {
    const fridge = document.querySelector<HTMLDialogElement>("[data-fridge]");
    if (!fridge || fridge.dataset.ready) return;
    fridge.dataset.ready = "1";
    turnstile = {};
    const form = fridge.querySelector<HTMLFormElement>("[data-fridge-form]")!;
    const status = fridge.querySelector<HTMLElement>("[data-fridge-status]")!;
    const send = fridge.querySelector<HTMLButtonElement>("[data-fridge-send]")!;

    fridge.querySelector("[data-fridge-close]")!.addEventListener("click", () => fridge.close());
    fridge.addEventListener("click", (e) => e.target === fridge && fridge.close());
    fridge.addEventListener("close", () => document.dispatchEvent(new CustomEvent("town:focus")));

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const value = (k: string) => String(data.get(k) ?? "").trim();
      send.disabled = true;
      status.classList.remove("fridge__status--error");
      status.textContent = "Pinning…";
      try {
        const token = await turnstileToken(form.querySelector("[data-fridge-turnstile]")!);
        const res = await fetch("/api/fridge", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ message: value("message"), name: value("name"), contact: value("contact"), website: value("website"), turnstileToken: token }),
        });
        if (!res.ok) throw new Error((await res.json().catch(() => null))?.error ?? "The magnet slipped. Try again?");
        form.reset();
        status.textContent = "Pinned! Dan gets a ping and will put it up on the fridge soon.";
      } catch (err) {
        status.classList.add("fridge__status--error");
        status.textContent = err instanceof Error ? err.message : String(err);
      } finally {
        turnstile.token = undefined; // single use
        send.disabled = false;
      }
    });

    if (fridgePending) {
      fridgePending = false;
      void openFridge(fridge);
    }
  });

  // The wall clock tells Dan's time, wherever the visitor is.
  document.addEventListener("town:clock", () => {
    const text = `It's ${formatEastern()} for Dan (Eastern Time).`;
    document.dispatchEvent(new CustomEvent("town:note", { detail: { title: "Clock", text } }));
  });
</script>

<style>
  /* ─────────────── the panel: a player profile, RPG character-sheet style ─────────────── */
  .sheet {
    display: grid;
    gap: 1rem;
  }
  .sheet-label {
    margin: 0 0 0.6rem;
    font: 400 0.6rem/1.5 var(--font-retro, monospace);
    color: var(--teal-ink);
    text-transform: uppercase;
  }
  .sheet-id {
    display: flex;
    gap: 1.1rem;
    align-items: center;
  }
  .sheet-id :global(.sheet-id__avatar) {
    width: 112px;
    height: 112px;
    flex: none;
    border: 3px solid var(--ink);
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 0 var(--ink);
  }
  .sheet-id__name {
    margin: 0 0 0.5rem;
    font: 400 clamp(1.05rem, 2.2vw, 1.4rem) / 1.3 var(--font-retro, monospace);
  }
  .sheet-id__name:focus {
    outline: none;
  }
  .sheet-id__meta {
    margin: 0;
    font: 1.2rem/1.2 var(--font-terminal, monospace);
  }
  .sheet-id__meta div {
    display: flex;
    gap: 0.5rem;
  }
  .sheet-id__meta dt {
    color: var(--ink-soft);
    text-transform: uppercase;
  }
  .sheet-id__meta dt::after {
    content: ":";
  }
  .sheet-id__meta dd {
    margin: 0;
  }

  .sheet-box {
    padding: 0.9rem 1rem;
    background: var(--paper);
    border: 3px solid var(--ink);
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 0 var(--ink);
  }
  .sheet-box > :last-child {
    margin-bottom: 0;
  }
  .sheet-box h2 {
    margin-top: 0;
  }
  .sheet-box--dark {
    background: #0f1a33;
    color: #e8f1ff;
  }
  .sheet-box--dark .sheet-label {
    color: var(--sun);
  }
  .lead {
    font-size: 1.05rem;
    font-weight: 600;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: 0.75rem 1rem;
    margin: 0;
  }
  .stats dt {
    font: 400 0.5rem/1.4 var(--font-retro, monospace);
    color: #9fb3d9;
    text-transform: uppercase;
  }
  .stats dd {
    margin: 0;
    font: 1.8rem/1 var(--font-terminal, monospace);
    color: var(--grass);
  }

  .quest {
    margin-bottom: 0.4rem;
  }
  .quest__open {
    font-size: 0.9rem;
  }

  .achievements {
    display: grid;
    gap: 0.35rem;
  }
  .achievements li {
    position: relative;
    padding-left: 1.4rem;
  }
  .achievements li::before {
    content: "★";
    position: absolute;
    left: 0;
    color: var(--sun);
    text-shadow: 1px 1px 0 var(--ink);
  }
  .achievements__more {
    margin-top: 0.5rem;
  }
  .achievements__more summary {
    cursor: pointer;
    font: 400 0.5rem/2 var(--font-retro, monospace);
    text-transform: uppercase;
    color: var(--coral-ink);
  }
  .achievements__more[open] summary {
    margin-bottom: 0.35rem;
  }

  .sheet-more {
    margin: 0.6rem 0 0;
    font-size: 0.9rem;
  }
  .side-quests {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
  }

  .next {
    margin: 0.5rem 0 0;
  }
  .room-hint {
    font-size: 0.9rem;
    margin: 0;
  }

  /* ─────────────── close-ups (the TV, the desk): the room fills the space where the map was ─────────────── */
  .pov-dialog {
    position: fixed;
    inset: var(--header-h) var(--panel-w) 0 0;
    width: auto;
    height: auto;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    background: #2b1d14;
    font: 10px/1.6 var(--font-retro, monospace);
  }
  .pov-dialog::backdrop {
    background: rgba(20, 12, 6, 0.55);
  }
  .pov {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .pov__canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }
  /* Placed over the screen in the art by PovView (town/pov.ts). */
  .pov__screen {
    position: absolute;
    overflow: hidden;
  }
  .tv__screen {
    background: #22303f;
    animation: tv-on 0.45s ease-out 0.25s both;
  }
  .tv__screen :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  @keyframes tv-on {
    0% {
      transform: scaleY(0.01);
      filter: brightness(4);
    }
    60% {
      transform: scaleY(1);
      filter: brightness(2);
    }
  }
  .pov__bar {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 14px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    padding: 10px 12px;
    color: #181820;
    background: rgba(248, 248, 240, 0.95);
    box-shadow:
      0 -3px 0 0 #181820,
      0 3px 0 0 #181820,
      -3px 0 0 0 #181820,
      3px 0 0 0 #181820;
  }
  .pov__title {
    flex: 1;
    min-width: 12em;
    margin: 0;
    font: inherit;
  }
  .pov__btn {
    min-height: 36px;
    padding: 8px 12px;
    font: inherit;
    color: #181820;
    text-decoration: none;
    background: #ffffff;
