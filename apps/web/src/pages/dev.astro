---
import TownLayout from "../layouts/TownLayout.astro";
import PixelPortrait from "../components/PixelPortrait.astro";
import ProjectCard from "../components/ProjectCard.astro";
import LinkRow from "../components/LinkRow.astro";
import StackChip from "../components/StackChip.astro";
import PixelLogo from "../components/PixelLogo.astro";
import GitHubStats from "../components/GitHubStats.astro";
import { profile, codename, formatMonth, formatRange, projectsByDate } from "../lib/profile";
import { logoFor, techUsage } from "../lib/stack";

const first = profile.identity.short_name;
const current = profile.experience.find((e) => e.end === null);
const edu = profile.education[0];

// ───── the mission timeline: projects and roles, oldest first ─────
/** "Johnson & Johnson" → "J&J", "Institutional Research Department, Gettysburg College" → "GETTYSBURG COLLEGE". */
const orgCode = (org: string) => {
  if (org.includes("&"))
    return org
      .split("&")
      .map((s) => s.trim()[0])
      .join("&");
  return (org.split(",").at(-1) ?? org).trim().toUpperCase();
};
const LINK_LABELS: Record<string, string> = { demo: "Launch the demo ↗", code: "Source code ↗", paper: "Read the paper ↗", play: "Play it in the Arcade" };

interface Entry {
  id: string;
  kind: "project" | "role";
  code: string;
  title: string;
  sub: string;
  start: string;
  end: string | null;
  status: "ACTIVE" | "COMPLETE";
  objective: string;
  results: string[];
  stack: string[];
  links: { label: string; href: string }[];
}
const entries: Entry[] = [
  ...profile.projects.map((p) => ({
    id: `p-${p.id}`,
    kind: "project" as const,
    code: codename(p.title, p.id),
    title: p.title,
    sub: p.start ? formatRange(p.start, p.end ?? null) : formatMonth(p.date),
    start: p.start ?? p.date,
    end: p.end ?? null,
    status: p.end === null ? ("ACTIVE" as const) : ("COMPLETE" as const),
    objective: p.tagline,
    results: [],
    stack: p.tags,
    links: [
      { label: "Full debrief →", href: `/projects/${p.id}` },
      ...Object.entries(p.links).map(([k, href]) => ({ label: LINK_LABELS[k] ?? `${k} ↗`, href })),
    ],
  })),
  ...profile.experience.map((e) => ({
    id: `r-${e.id}`,
    kind: "role" as const,
    code: orgCode(e.org),
    title: e.role,
    sub: `${e.org}${e.location ? ` · ${e.location}` : ""} · ${formatRange(e.start, e.end)}`,
    start: e.start,
    end: e.end,
    status: e.end === null ? ("ACTIVE" as const) : ("COMPLETE" as const),
    objective: e.highlights[0] ?? "",
    results: e.highlights.slice(1),
    stack: e.skills ?? [],
    links: [],
  })),
].sort((a, b) => a.start.localeCompare(b.start) || a.kind.localeCompare(b.kind));
// Open on what Dan is doing now: the newest active entry, else the newest.
const opening = [...entries].reverse().find((e) => e.status === "ACTIVE") ?? entries.at(-1)!;

// ───── the stack radar: the more a tech was used, the nearer the centre ─────
const usage = techUsage();
const used = usage.filter((u) => u.usedIn.length > 0);
const toolbox = usage.filter((u) => u.usedIn.length === 0);
const ringOf = (n: number, i: number) => (n >= 4 ? 0 : n === 3 ? 1 : n === 2 ? 2 : 3 + (i % 2));
const RING_R = [0.12, 0.34, 0.54, 0.74, 0.92];
const rings = new Map<number, number[]>();
used.forEach((u, i) => {
  const ring = ringOf(u.usedIn.length, i);
  rings.set(ring, [...(rings.get(ring) ?? []), i]);
});
const blips = used.map((u, i) => {
  const ring = ringOf(u.usedIn.length, i);
  const members = rings.get(ring)!;
  const k = members.indexOf(i);
  const a = (k / members.length) * Math.PI * 2 + ring * 0.7 - Math.PI / 2;
  const r = RING_R[ring]!;
  return { ...u, r, a, hex: logoFor(u.name).hex, x: 50 + Math.cos(a) * r * 50, y: 50 + Math.sin(a) * r * 50 };
});
const RING_NAMES = ["Core", "Go-to", "Regular", "Flown once"];

// ───── what the room's screens show (town/dev.ts) ─────
const feed = {
  timeline: entries.map((e) => ({ label: e.code, kind: e.kind, year: e.start.slice(0, 4), t: Date.parse(`${e.start}-01`) })),
  blips: blips.map((b) => ({ hex: b.hex, r: b.r, a: b.a })),
};

// Every skill group, the math included, as pixel-logo chips.
const skillGroups = profile.skills;
const featured = projectsByDate().filter((p) => p.featured);

---

<TownLayout place="dev" room title="Dev Center" description={`Mission control for ${first}'s projects, stack, and live GitHub and LeetCode activity.`}>
  <div class="mcp">
    <header class="mcp-id">
      <PixelPortrait class="mcp-id__avatar" />
      <div class="mcp-id__text">
        <p class="mcp-kicker">📡 Dev Center · Mission control</p>
        <h1 id="panel-title" class="mcp-id__name" tabindex="-1">{profile.identity.name}</h1>
        <p class="mcp-id__role">{profile.identity.headline}</p>
      </div>
    </header>

    <p class="mcp-hint">
      Welcome aboard. LeBronette at the front desk knows everything about {first}. The viewscreen runs his mission timeline, the radar scans his stack,
      and the telemetry wall is live.
    </p>

    <section class="mcp-card" aria-labelledby="tldr-title" data-mc data-feed={JSON.stringify(feed)}>
      <h2 id="tldr-title" class="mcp-h">TL;DR</h2>
      <p class="mcp-lead">{profile.identity.tagline}</p>
      <dl class="mcp-status">
        {
          current && (
            <div>
              <dt>Now</dt>
              <dd>
                {current.role} @ {current.org}
              </dd>
            </div>
          )
        }
        {
          edu && (
            <div>
              <dt>Trained</dt>
              <dd>
                {edu.degree}, {edu.school}
                {edu.rank && <> · rank {edu.rank}</>}
              </dd>
            </div>
          )
        }
        <div>
          <dt>Record</dt>
          <dd>{featured.length} featured launches · {profile.experience.length} crew assignments</dd>
        </div>
        {
          profile.identity.open_to && (
            <div>
              <dt>Open to</dt>
              <dd>{profile.identity.open_to}</dd>
            </div>
          )
        }
      </dl>
      <div class="mcp-fastlane">
        <a class="mcp-btn mcp-btn--primary" href="/reception">🎧 Ask LeBronette</a>
        <button type="button" class="mcp-btn" data-open="timeline">🛰️ Timeline</button>
        <button type="button" class="mcp-btn" data-open="radar">◎ Radar</button>
        <button type="button" class="mcp-btn" data-open="telemetry">📈 Telemetry</button>
      </div>
    </section>

    <section aria-labelledby="stack-title">
      <h2 id="stack-title" class="mcp-h">Stack</h2>
      {
        skillGroups.map((g) => (
          <div class="mcp-group">
            <h3 class="mcp-sub">{g.group}</h3>
            <ul class="stack-chips">
              {g.items.map((i) => (
                <StackChip name={i} />
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section aria-labelledby="launches-title">
      <h2 id="launches-title" class="mcp-h">Launches</h2>
      <ul class="clean mcp-launches">
        {
          projectsByDate().map((p) => (
            <li>
              <ProjectCard project={p} />
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="comms-title">
      <h2 id="comms-title" class="mcp-h">Comms</h2>
      <div class="mcp-comms">
        <LinkRow />
      </div>
    </section>

    <details class="mcp-build" id="how-its-built">
      <summary class="mcp-h">How this town is built</summary>
      <ul>
        <li><strong>Single source of truth.</strong> Everything here is compiled from one private, schema-validated <code>profile.yaml</code>. Pushing to it rebuilds the site, the twin and LeBronette.</li>
        <li><strong>Static first.</strong> Astro renders every page to HTML at build time. JavaScript only loads for the town, the chats and the Arcade.</li>
        <li><strong>A tiny engine, no game framework.</strong> Grid movement, collision and tap-to-move in a few hundred lines of TypeScript. The render loop sleeps when you stand still.</li>
        <li><strong>Rust → WebAssembly.</strong> The Java Mancala bot, ported to Rust (~37 KB of WASM in a Web Worker), with a parity suite over 247 recorded positions.</li>
        <li><strong>Edge API.</strong> A Cloudflare Worker serves the site, refreshes GitHub / LeetCode / Spotify daily, and proxies the chats with rate limiting. Hosting: $0.</li>
      </ul>
    </details>
  </div>

  <!-- ─────────── the viewscreen: the mission timeline, and a briefing per entry ─────────── -->
  <dialog slot="screen" class="mc" data-mc-dialog="timeline" aria-labelledby="mc-timeline-title">
    <div class="mc__bar">
      <h2 id="mc-timeline-title" class="mc__title">Mission timeline</h2>
      <button type="button" class="mc__close" data-mc-close aria-label="Close the timeline">✕</button>
    </div>
    <ol class="clean mc-track" aria-label="Projects and roles, oldest first">
      {
        entries.map((e) => (
          <li>
            <button type="button" class={`mc-tick mc-tick--${e.kind}`} data-brief-for={e.id} aria-pressed={e === opening ? "true" : "false"}>
              <span class="mc-tick__year">{e.start.slice(0, 4)}</span>
              <span class="mc-tick__code">{e.code}</span>
            </button>
          </li>
        ))
      }
    </ol>
    <div class="mc__body">
      {
        entries.map((e) => (
          <article class="brief" data-brief={e.id} hidden={e !== opening} aria-label={`Briefing: ${e.title}`}>
            <p class="brief__kicker">
              <span class={`brief__kind brief__kind--${e.kind}`}>{e.kind === "role" ? "Crew assignment" : "Launch"}</span>
              <span class={`brief__status brief__status--${e.status.toLowerCase()}`}>{e.status}</span>
            </p>
            <h3 class="brief__code">{e.code}</h3>
            <p class="brief__title">{e.title}</p>
            <p class="brief__sub">{e.sub}</p>
            {e.objective && (
              <>
                <h4 class="brief__label">Objective</h4>
                <p>{e.objective}</p>
              </>
            )}
            {e.results.length > 0 && (
              <>
                <h4 class="brief__label">Results</h4>
                <ul class="brief__results">
                  {e.results.map((r) => (
                    <li>{r}</li>
                  ))}
                </ul>
              </>
            )}
            {e.stack.length > 0 && (
              <>
                <h4 class="brief__label">Payload</h4>
                <ul class="stack-chips">
                  {e.stack.map((t) => (
                    <StackChip name={t} />
                  ))}
                </ul>
              </>
            )}
            {e.links.length > 0 && (
              <p class="brief__links">
                {e.links.map((l) => (
                  <a class="mc-btn" href={l.href} {...(l.href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
                    {l.label}
                  </a>
                ))}
              </p>
            )}
          </article>
        ))
      }
    </div>
  </dialog>

  <!-- ─────────── the stack radar ─────────── -->
  <dialog slot="screen" class="mc" data-mc-dialog="radar" aria-labelledby="mc-radar-title">
    <div class="mc__bar">
      <h2 id="mc-radar-title" class="mc__title">Stack radar</h2>
      <button type="button" class="mc__close" data-mc-close aria-label="Close the radar">✕</button>
    </div>
    <div class="mc__body radar-layout">
      <div class="radar" role="group" aria-label="Technologies, nearer the centre the more projects and roles used them">
        <span class="radar__sweep" aria-hidden="true"></span>
        {RING_R.map((r) => <span class="radar__ring" style={`--r: ${r * 100 + 4}%`} aria-hidden="true" />)}
        {
          blips.map((b, i) => (
            <button
              type="button"
              class="blip"
              style={`left: ${b.x.toFixed(2)}%; top: ${b.y.toFixed(2)}%; --brand: ${b.hex}`}
              data-tech={i}
              aria-label={`${b.name}: used in ${b.usedIn.length}`}
              aria-pressed="false"
            >
              <PixelLogo name={b.name} class="blip__logo" />
            </button>
          ))
        }
      </div>
      <div class="radar-info">
        <p class="radar-info__hint" data-tech-hint>
          Tap a blip. The nearer the centre, the more of {first}'s projects and roles used it. <strong>{used[0]?.name}</strong> sits in the middle.
        </p>
        {
          blips.map((b, i) => (
            <section class="tech" data-tech-detail={i} hidden>
              <ul class="stack-chips">
                <StackChip name={b.name} />
              </ul>
              <p class="tech__count">
                {RING_NAMES[Math.min(3, ringOf(b.usedIn.length, i))]} · used in {b.usedIn.length} {b.usedIn.length === 1 ? "mission" : "missions"}
              </p>
              <ul class="tech__uses">
                {b.usedIn.map((u) => (
                  <li>
                    <span aria-hidden="true">{u.kind === "project" ? "🚀" : "🛰️"}</span>{" "}
                    {u.kind === "project" ? <a href={`/projects/${u.id}`}>{u.title}</a> : u.title}
                    <span class="muted"> · {u.date.slice(0, 4)}</span>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
        {
          toolbox.length > 0 && (
            <>
              <h3 class="brief__label">Also in the toolbox</h3>
              <ul class="stack-chips">
                {toolbox.map((u) => (
                  <StackChip name={u.name} />
                ))}
              </ul>
            </>
          )
        }
      </div>
    </div>
  </dialog>

  <!-- ─────────── the telemetry wall ─────────── -->
  <dialog slot="screen" class="mc" data-mc-dialog="telemetry" aria-labelledby="mc-telemetry-title">
    <div class="mc__bar">
      <h2 id="mc-telemetry-title" class="mc__title">Telemetry</h2>
      <button type="button" class="mc__close" data-mc-close aria-label="Close the telemetry">✕</button>
    </div>
    <div class="mc__body">
      <div class="readouts">
        <div class="readout">
          <p class="readout__label">GitHub streak</p>
          <p class="readout__value" data-streak>--</p>
          <p class="readout__unit">days in a row</p>
        </div>
        <div class="readout">
          <p class="readout__label">Contributions</p>
          <p class="readout__value" data-contribs>--</p>
          <p class="readout__unit">in the last year</p>
        </div>
      </div>
      <h3 class="brief__label">LeetCode</h3>
      <div class="dials" data-dials>
        {
          (["easy", "medium", "hard"] as const).map((d) => (
            <figure class={`dial dial--${d}`} data-dial={d} style="--v: 0">
              <svg viewBox="0 0 100 60" aria-hidden="true">
                <path class="dial__track" d="M10 55 A40 40 0 0 1 90 55" pathLength="100" />
                <path class="dial__fill" d="M10 55 A40 40 0 0 1 90 55" pathLength="100" />
              </svg>
              <figcaption>
                <span class="dial__value" data-dial-value>--</span>
                <span class="dial__name">{d}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <p class="readout__unit" data-lc-total></p>
      <GitHubStats />
    </div>
  </dialog>

</TownLayout>

<script>
  import { navigate } from "astro:transitions/client";
  import { formatEastern } from "../town/home";
  import { setDevFeed, streakOf, type DevFeed } from "../town/dev";
  import { objectRect, zoomIn } from "../town/zoom";
  import { fmtNumber, loadStats } from "../lib/stats-client";

  /** Which room object each screen zooms out of. */
  const OBJECT: Record<string, string> = { timeline: "timeline", radar: "radar", telemetry: "telemetry" };
  /** A screen asked for before the Dev Center page was shown (it opens once the page loads). */
  let pending: string | null = null;

  function open(name: string) {
    const dialog = document.querySelector<HTMLDialogElement>(`[data-mc-dialog="${name}"]`);
    if (!dialog) {
      pending = name;
      void navigate("/dev");
      return;
    }
    if (dialog.open) return;
    const from = objectRect(OBJECT[name]!);
    dialog.showModal();
    zoomIn(dialog, from);
    // The track only has a size once open: bring the selected entry into view.
    if (name === "timeline") dialog.querySelector('[aria-pressed="true"]')?.scrollIntoView({ block: "nearest", inline: "center" });
  }

  for (const name of Object.keys(OBJECT)) document.addEventListener(`town:${name}`, () => open(name));

  // The mission clock tells Dan's time, wherever the visitor is.
  document.addEventListener("town:dev-clock", () => {
    const text = `Mission time: ${formatEastern()} (Eastern), where Dan is.`;
    document.dispatchEvent(new CustomEvent("town:note", { detail: { title: "Mission clock", text } }));
  });

  /** One of a group of buttons is pressed at a time; it shows the panel with the matching key. */
  function select(buttons: HTMLElement[], panels: HTMLElement[], key: (el: HTMLElement) => string | undefined, on: HTMLElement) {
    for (const b of buttons) b.setAttribute("aria-pressed", String(b === on));
    for (const p of panels) p.hidden = key(p) !== key(on);
  }

  document.addEventListener("astro:page-load", () => {
    const root = document.querySelector<HTMLElement>("[data-mc]");
    if (!root) return;
    setDevFeed(JSON.parse(root.dataset.feed!) as Partial<DevFeed>);

    for (const dialog of document.querySelectorAll<HTMLDialogElement>("[data-mc-dialog]")) {
      dialog.querySelector("[data-mc-close]")!.addEventListener("click", () => dialog.close());
      dialog.addEventListener("close", () => document.dispatchEvent(new CustomEvent("town:focus")));
      // A click on the backdrop (outside the console) closes it too.
      dialog.addEventListener("click", (e) => e.target === dialog && dialog.close());
    }
    for (const b of document.querySelectorAll<HTMLButtonElement>("[data-open]")) b.addEventListener("click", () => open(b.dataset.open!));

    // Timeline: each tick shows its briefing.
    const ticks = [...document.querySelectorAll<HTMLElement>("[data-brief-for]")];
    const briefs = [...document.querySelectorAll<HTMLElement>("[data-brief]")];
    for (const t of ticks)
      t.addEventListener("click", () => {
        select(ticks, [], () => undefined, t);
        for (const b of briefs) b.hidden = b.dataset.brief !== t.dataset.briefFor;
      });

    // Radar: each blip shows where that tech was used.
    const blips = [...document.querySelectorAll<HTMLElement>("[data-tech]")];
    const details = [...document.querySelectorAll<HTMLElement>("[data-tech-detail]")];
    const hint = document.querySelector<HTMLElement>("[data-tech-hint]")!;
    for (const b of blips)
      b.addEventListener("click", () => {
        hint.hidden = true;
        select(blips, details, (el) => el.dataset.tech ?? el.dataset.techDetail, b);
      });

    // Live numbers, for the wall in the room and the telemetry screen.
    void loadStats().then((stats) => {
      const gh = stats?.github;
      const lc = stats?.leetcode;
      const streak = gh ? streakOf(gh.calendar) : null;
      setDevFeed({ heat: gh ? gh.calendar.map((d) => d.level) : null, streak, leet: lc ? { ...lc.solved, totals: lc.totals } : null });
      const set = (sel: string, text: string) => {
        const el = document.querySelector(sel);
        if (el) el.textContent = text;
      };
      if (gh) {
        set("[data-streak]", String(streak));
        set("[data-contribs]", fmtNumber(gh.totalContributions));
      }
      if (lc) {
        for (const d of ["easy", "medium", "hard"] as const) {
          const dial = document.querySelector<HTMLElement>(`[data-dial="${d}"]`);
          if (!dial) continue;
          dial.style.setProperty("--v", String(Math.round((lc.solved[d] / Math.max(1, lc.totals[d])) * 100)));
          dial.querySelector("[data-dial-value]")!.textContent = fmtNumber(lc.solved[d]);
        }
        set("[data-lc-total]", `${fmtNumber(lc.solved.all)} solved of ${fmtNumber(lc.totals.all)}. The dials show the share of each difficulty.`);
      }
    });

    if (pending) {
      const name = pending;
      pending = null;
      open(name);
    }
  });
</script>

<style>
  /* ─────────────── the panel (theme: .mcp in global.css) ─────────────── */
  /* ID badge: the pixel character and the name. */
  .mcp-id {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .mcp-id :global(.mcp-id__avatar) {
    flex: none;
    width: 88px;
    height: 88px;
    border: 3px solid var(--mcp-cyan);
    box-shadow:
      4px 4px 0 #070a14,
      0 0 16px rgba(62, 230, 255, 0.35);
    image-rendering: pixelated;
  }
  .mcp-id__text {
    display: grid;
    gap: 0.45rem;
    min-width: 0;
  }
  .mcp-id__name {
    font: 400 clamp(1rem, 2.2vw, 1.35rem) / 1.35 var(--font-retro, monospace);
    color: #fff;
    text-shadow: 3px 3px 0 #1d6f86;
  }
  .mcp-id__name:focus {
    outline: none;
  }
  .mcp-id__role {
    color: var(--mcp-green);
  }
  .mcp-id__role::before {
    content: "> ";
  }
  .mcp-id__role::after {
    content: "▮";
    margin-left: 0.15em;
    animation: mcp-blink 1s steps(1) infinite;
  }
  .mcp-hint {
    color: var(--mcp-dim);
  }

  /* TL;DR readout. */
  .mcp-lead {
    color: #fff;
  }
  .mcp-status {
    display: grid;
    gap: 0.35rem;
    margin: 0;
  }
  .mcp-status div {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 0.6rem;
  }
  .mcp-status dt {
    color: var(--mcp-amber);
    text-transform: uppercase;
  }
  .mcp-status dt::after {
    content: ":";
  }
  .mcp-status dd {
    margin: 0;
  }
  .mcp-fastlane {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .mcp-group + .mcp-group {
    margin-top: 0.9rem;
  }

  /* Launches: a grid of project cards (components/ProjectCard.astro). */
  .mcp-launches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.9rem;
  }

  /* Comms: the site's link buttons, as console buttons. */
  .mcp-comms :global(.btn) {
    font: 400 0.5rem/1.4 var(--font-retro, monospace);
    color: var(--mcp-text);
    background: var(--mcp-card);
    border: 2px solid var(--mcp-line);
    border-radius: 0;
    box-shadow: 3px 3px 0 #070a14;
  }
  .mcp-comms :global(.btn:hover),
  .mcp-comms :global(.btn:focus-visible) {
    color: var(--mcp-cyan);
    border-color: var(--mcp-cyan);
  }

  .mcp-build summary {
    cursor: pointer;
    margin-bottom: 0 !important;
  }
  .mcp-build[open] summary {
    margin-bottom: 0.6rem !important;
  }
